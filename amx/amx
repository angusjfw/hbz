def cmd_transcripts(a):
    rows = []
    for p, sid in transcript_files(a.harness, a.cwd):
        hits = 0
        if a.grep:
            try:
                hits = p.read_text(errors="replace").count(a.grep)
            except OSError:
                pass
            if not hits:
                continue
        names = pi_session_names(p) if a.harness == "pi" else []
        if a.name and a.name not in names:
            continue
        rows.append((p.stat().st_mtime, sid, hits, ",".join(names), p))
    rows.sort(reverse=True)
    for mt, sid, hits, names, p in rows:
        print(f"{datetime.fromtimestamp(mt):%Y-%m-%d %H:%M}\t{sid}\thits={hits}\tnames={names or '-'}\t{p}")
    if not rows:
        print(f"no transcripts for {a.harness} in {a.cwd}", file=sys.stderr)
        sys.exit(1)


def cmd_reconcile(a):
    reg = Registry.load()
    live = set(list_sessions())
    all_panes = pane_rows()
    pane_ids = {p["pane_id"] for p in all_panes}
    addrs = {f"{p['session']}:{p['window']}.{p['pane']}" for p in all_panes}
    known = set()
    out = []
    for e in reg.entries():
        d = e.as_dict()
        h = harness_of(e)
        ts = d.get("tmux_session")
        if ts:
            known.add(ts)
        if a.harness and a.harness not in entry_harnesses(e):
            continue
        if ts and ts not in live:
            cwd = str(Path(d.get("worktree") or d.get("cwd") or "/nonexistent").expanduser())
            cand = sorted({p["session"] for p in all_panes if p["cwd"] == cwd or p["session"] == e.name}
                          - {x for x in live if reg.by_tmux_session(x)})
            if cand:
                out.append(("renamed?", e.name, f"tmux_session {ts} gone; live candidate(s): {', '.join(cand)}"))
            else:
                out.append(("dead", e.name, f"tmux_session {ts} not running"))
        elif ts:
            panes = inspect_panes(ts, reg)
            running = {(p["kind"], p["session_id"]) for p in panes if p["session_id"]}
            for p in panes:
                if p.get("dead"):
                    out.append(("exited", e.name, f"pane {p['pane_id']} exited (status {p.get('exit_status') or 'unknown'}); inspect its retained output"))
                if p.get("harness_conflict"):
                    out.append(("harness-conflict", e.name, f"pane {p['pane_id']}: recorded {p.get('managed_harness')}, observed {p['kind']}"))
                if p["kind"] in AGENTS and not p["session_id"]:
                    out.append(("no-id", e.name, f"{p['kind']} pane {p['pane_id']} ({p['cwd']}): id unknown; "
                                f"try amx identify {e.name}, or find the native ID"))
                elif p["primary"] and p["session_id"] and (p["kind"], p["session_id"]) != (h, e.get("resumed_session_id")):
                    out.append(("session-changed", e.name, f"primary ID differs: amx identify {e.name}"))
                elif p["kind"] in AGENTS and not p["primary"] and (p["kind"], p["session_id"]) not in entry_keys(e):
                    out.append(("unrecorded", e.name, f"pane {p['pane_id']} runs {p['session_id']} (cwd {p['cwd']}) "
                                f"with no worker line: amx identify {e.name}"))
            workers = {worker_key(w): w for w in worker_records(e)}
            unresolved = unresolved_workers(workers, panes)
            for key, worker in workers.items():
                wh, wid = key
                if key in unresolved:
                    out.append(("recovery-only", e.name, f"{wh} {wid} is last-known metadata for pane {unresolved[key]['pane_id']}, "
                                "not its confirmed current identity; resolve the pane before discarding the record"))
                elif key not in running:
                    out.append(("stale-worker", e.name, f"{wh} {wid} not running: amx reg worker drop {e.name} {wid} --harness {wh}"))
            if d.get("paused"):
                prim = next((p for p in panes if p["primary"]), None)
                if prim and prim["state"] == "working":
                    out.append(("busy-paused", e.name, "paused but primary pane is working"))
        elif d.get("wrap_requested"):
            out.append(("wrap-pending", e.name, "worker requested wrap; journal + remove entry"))
        elif not d.get("shutdown"):
            out.append(("unknown", e.name, "no tmux_session, not shutdown, no wrap_requested"))
    mgr_sessions = set()
    for m in reg.header.get_all("manager"):
        addr = m.split()[0]
        mgr_sessions.add(addr.split(":")[0])
        if addr not in addrs and addr not in pane_ids:
            out.append(("stale-manager", addr, f"no such pane: amx reg unset @header manager={addr}"))
    for s in sorted(live - known - mgr_sessions):
        if is_shared(s, reg):
            continue  # the user's own session; never an entry
        agents = [p for p in inspect_panes(s, reg) if p["kind"] in AGENTS]
        if agents:
            kinds = ",".join(sorted({p["kind"] for p in agents}))
            out.append(("unregistered", s, f"{len(agents)} agent pane(s) ({kinds}); register or ignore"))
    for pf in STATE.glob("watch.*.pid"):
        try:
            pid = int(pf.read_text().strip())
            os.kill(pid, 0)
        except (ValueError, OSError):
            out.append(("stale-watch", str(pf), f"dead pid file: rm {pf}"))
    for kind, who, msg in out:
        print(f"{kind}\t{who}\t{msg}")
    if not out:
        print("ok")


def read_last_writer():
    """The last writer's pane id, or "" if the file isn't a plain file holding one.
    Its contents reach the manager's conversation, so nothing else passes."""
    try:
        if not LAST_WRITER.is_file() or LAST_WRITER.is_symlink():
            return ""
        v = LAST_WRITER.read_text()[:32].strip()
    except OSError:
        return ""
    return v if re.fullmatch(r"%\d+", v) else ""


def cmd_watch(a):
    def mtime():
        try:
            return REGISTRY.stat().st_mtime_ns
        except OSError:
            return None
    last = mtime()
    while True:
        time.sleep(a.interval)
        cur = mtime()
        if cur != last:
            last = cur
            writer = read_last_writer()
            if a.ignore_pane and writer == a.ignore_pane:
                continue
            print(f"changed writer={writer or '?'}", flush=True)


