    p.set_defaults(fn=cmd_hook)

    p = sub.add_parser("migrate", help="move the old claude-manager state here (idempotent)")
    p.set_defaults(fn=cmd_migrate)

    p = sub.add_parser("reference", help="print the registry, state and file formats")
    p.set_defaults(fn=lambda a: print((Path(__file__).resolve().parent / "REFERENCE.md").read_text(), end=""))

    p = sub.add_parser("switcher", help="install the prefix+w binding that badges paused sessions")
    p.set_defaults(fn=lambda a: (install_switcher(), print("installed")))

    p = sub.add_parser("transcripts", help="list a harness's transcripts for a cwd")
    p.add_argument("harness", choices=AGENTS)
    p.add_argument("cwd")
    p.add_argument("--grep")
    p.add_argument("--name", help="pi: session name")
    p.set_defaults(fn=cmd_transcripts)

    p = sub.add_parser("reconcile", help="read-only drift report")
    p.add_argument("--harness")
    p.set_defaults(fn=cmd_reconcile)

    p = sub.add_parser("watch", help="print a line whenever the registry changes (run under Monitor)")
    p.add_argument("--interval", type=float, default=1.0)
    p.add_argument("--ignore-pane", help="skip changes written from this pane (your own)")
    p.set_defaults(fn=cmd_watch)

    a = ap.parse_args(argv)
    try:
        a.fn(a)
    except Refused as e:
        print(e, file=sys.stderr)
        sys.exit(1)
    except CmError as e:
        print(f"amx: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
