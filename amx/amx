def write_resume_state(session, out, reg=None):
    reg = reg or Registry.load()
    a = argparse.Namespace(session=session, out=out)
    entries = reg.by_tmux_session(a.session)
    entry = entries[0] if len(entries) == 1 else None
    name = entry.name if entry else a.session
    harness = harness_of(entry) if entry else "claude"
    panes = inspect_panes(a.session, reg)
    lines = [f"# Resume state: {name}", "", f"shutdown: {now_str()}", f"harness: {harness}", ""]
    missing = []
    wins = {}
    for p in panes:
        wins.setdefault((p["window"], p["window_name"], p["layout"]), []).append(p)
    for (w, wname, layout), ps in wins.items():
        lines += [f"## window {w}: {wname}", f"layout: {layout}", ""]
        for p in ps:
            cwd = (p.get("launch_cwd") if p["kind"] == "cmd" else None) or p["cwd"]
            lines += [f"### pane {p['pane']}", f"cwd: {cwd}", f"primary: {str(p['primary']).lower()}"]
            if p["kind"] in AGENTS:
                args = agent_arguments(p.get("agent_args"))
                if not p["session_id"]:
                    missing.append(f"window {w} pane {p['pane']} ({p['kind']}, {p['cwd']})")
                    lines.append("command: ")
                else:
                    nm = name if p["primary"] else (f"{name}-{p['label']}" if p["label"] else None)
                    lines.append(f"command: {resume_line(p['kind'], p['session_id'], p.get('effort'), nm, args)}")
                    lines.append(f"session_id: {p['session_id']}")
                lines.append(f"harness: {p['kind']}")
                for key in ("model", "effort"):
                    if p.get(key):
                        lines.append(f"{key}: {p[key]}")
                if args:
                    lines.append(f"agent_args: {json.dumps(args)}")
            elif p["kind"] == "cmd":
                lines.append(f"command: {p['command']}")
                lines.append("harness: command")
            else:
                lines.append("command:")
            if p["label"]:
                lines.append(f"label: {p['label']}")
            lines.append("")
    out = Path(a.out).expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text("\n".join(lines).rstrip() + "\n")
    return out, missing, panes


def parse_resume_state(text):
    """-> {"fields": {...}, "windows": [{"index", "name", "layout", "panes": [{...}]}]}"""
    res = {"fields": {}, "windows": []}
    win = pane = None
    for line in text.splitlines():
        m = re.match(r"^## window (\d+):\s*(.*)$", line)
        if m:
            win = {"index": int(m.group(1)), "name": m.group(2).strip(), "layout": None, "panes": []}
            res["windows"].append(win)
            pane = None
            continue
        if line.startswith("## "):
            win = pane = None  # prose section
            continue
        m = re.match(r"^### pane (\d+)\s*$", line)
        if m and win is not None:
            pane = {"index": int(m.group(1))}
            win["panes"].append(pane)
            continue
        m = FIELD_RE.match(line)
        if not m:
            continue
        k, v = m.group(1), (m.group(2) or "").strip()
        if pane is not None:
            if k == "claude_session_id":
                k = "session_id"
                pane.setdefault("harness", "claude")
            pane[k] = v
        elif win is not None:
            win[k] = v
        elif not res["windows"]:
            res["fields"][k] = v
    return res


# ---------------------------------------------------------------- commands: spawn, rebuild, kill

def mint_id():
    try:
        return Path("/proc/sys/kernel/random/uuid").read_text().strip()
    except OSError:
        import uuid
        return str(uuid.uuid4())


def start_pane(pane_id, cwd, line, harness, sid, agent_args=(), command="", label="",
               model=None, effort=None, primary=False):
    """tmux owns the command lifetime; a failed launch stays visible, with its status."""
    tmux("set-option", "-p", "-t", pane_id, "remain-on-exit", "on")
    for key, value in (("harness", harness), ("session_id", sid), ("agent_args", json.dumps(list(agent_args))),
                       ("command", command), ("label", label), ("launch_cwd", cwd),
                       ("model", model or ""), ("effort", effort or ""), ("primary", "1" if primary else "0")):
        tmux("set-option", "-p", "-t", pane_id, f"@amx_{key}", value)
    env = ["-e", f"AMX_STATE_DIR={STATE}", "-e", f"PATH={os.environ.get('PATH', os.defpath)}"]
    for key in ("AMX_AGENT_STATUS_DIR", "PI_CODING_AGENT_DIR", "PI_CODING_AGENT_SESSION_DIR", "CODEX_HOME", "CODEX_SQLITE_HOME"):
        if key in os.environ:
            env += ["-e", f"{key}={os.environ[key]}"]
    for attempt in range(5):
        result = tmux("respawn-pane", "-k", "-t", pane_id, "-c", cwd, *env, f"exec {line}", check=False)
        if result.returncode == 0:
            return
        # Retry only tmux's pre-exec tty allocation failure, never agent failures.
        if "fork failed: Device not configured" not in result.stderr or attempt == 4:
            die(f"could not launch in {pane_id}: {result.stderr.strip() or result.stdout.strip()}")
        time.sleep(0.1)


def wait_for_start(pane_id, timeout, settle=2.0):
    """Observe a continuous running interval, not readiness or a hook acknowledgement."""
    end = time.monotonic() + timeout
    running_since = None
    last_pid = None
    while True:
        r = tmux("display-message", "-p", "-t", pane_id,
                 "#{pane_dead}\t#{pane_dead_status}\t#{pane_pid}\t#{pane_dead_signal}", check=False)
        fields = r.stdout.strip("\n").split("\t")
        if r.returncode or len(fields) != 4:
            die(f"pane {pane_id} disappeared during startup")
        dead, status, pid, signal = fields
        if dead == "1":
            die(f"command in {pane_id} exited during startup (" +
                (f"signal {signal}" if signal else f"status {status or 'unknown'}") + "); pane retained")
        now = time.monotonic()
        if dead == "0" and pid:
            if pid != last_pid:
                running_since, last_pid = now, pid
            if now - running_since >= settle:
                return "running"
        else:
            running_since, last_pid = None, None
        if now >= end:
            die(f"startup observation timed out for {pane_id}; inspect the pane")
        time.sleep(min(0.1, max(0, end - now)))


def report_start(pane_id, timeout):
    try:
        print(f"startup={wait_for_start(pane_id, timeout)} (readiness not verified)")
    except CmError as e:
        print(f"WARNING: {e}", file=sys.stderr)
        sys.exit(3)


def write_brief(name, text_or_file):
    if not text_or_file:
        return None
    src = Path(text_or_file).expanduser()
    d = STATE / "briefs"
    d.mkdir(parents=True, exist_ok=True)
    dst = d / f"{name}.md"
    if src.resolve() != dst.resolve():
        shutil.copyfile(src, dst)
    return dst


def cmd_spawn(a):
    if not math.isfinite(a.timeout) or a.timeout <= 0:
        die("--timeout must be a positive finite number")
    if a.command is not None:
        if not a.command.strip() or "\n" in a.command or "\r" in a.command or "\t" in a.command:
            die("--command must be a nonempty single line without tabs")
        if a.harness and a.harness != "command":
            die("--command cannot be combined with an agent harness")
        a.harness = "command"
    if a.harness == "command" and (a.model or a.effort or a.brief_file or a.agent_arg):
        die("command sessions use --command, not model, effort, brief or agent arguments")
    if a.into:
        return spawn_into(a)
    if not (a.id and a.cwd and a.harness):
        die("spawn needs --harness, --id and --cwd (or --into)")
    cwd = str(Path(a.cwd).expanduser().resolve())
    if not Path(cwd).is_dir():
        die(f"cwd {cwd} doesn't exist (create the worktree first)")
    if has_session(a.id):
        die(f"tmux session '{a.id}' already exists: import it or pick another id")
    if Registry.load().entry(a.id):
        die(f"registry entry '{a.id}' already exists")
    sid = mint_id() if a.harness in ("claude", "pi") else ""
    brief = write_brief(a.id, a.brief_file)
    line = launch_line(a.harness, sid, a.model, a.effort, a.id, brief, a.agent_arg, a.command)
    tmux("new-session", "-d", "-s", a.id, "-n", a.id, "-c", cwd)
    pane_id = tmux("list-panes", "-t", f"={a.id}:", "-F", "#{pane_id}").stdout.split()[0]

    fields = [f"harness={a.harness}", f"tmux_session={a.id}", f"cwd={cwd}", f"agent_args={json.dumps(a.agent_arg)}"]
    if sid:
        fields.append(f"resumed_session_id={sid}")
    for k in ("ticket", "worktree", "branch", "model", "effort", "command"):
        v = getattr(a, k)
        if v:
            fields.append(f"{k}={v}")

    def fn(reg):
        b = reg.new(a.id)
        apply_assign(b, ["started=now"] + fields + ["last_touched=now"])
    mutate(fn)
    start_pane(pane_id, cwd, line, a.harness, sid, a.agent_arg, a.command or "",
               model=a.model, effort=a.effort, primary=True)
    print(f"session={a.id}\npane={pane_id}\nharness={a.harness}")
    report_start(pane_id, a.timeout)
    if a.harness == "codex":
        sid = record_pane_ids(a.id).get(pane_id, "")
    if a.harness in AGENTS:
        print(f"session_id={sid or 'unknown'}")
        if not sid:
            print("WARNING: running, but session ID is not available yet; use amx identify before shutdown", file=sys.stderr)
    else:
        print("resume=command-restart (not conversation resume)")


def spawn_into(a):
    reg = Registry.load()
    entries = reg.by_tmux_session(a.into)
    if len(entries) != 1:
        die(f"no single registry entry with tmux_session={a.into}")
    entry = entries[0]
    if not has_session(a.into):
        die(f"tmux session '{a.into}' isn't running")
    harness = a.harness or harness_of(entry)
    if harness == "command" and not a.command:
        die("command panes need --command")
    if not a.label or not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", a.label):
        die("--into needs --label (letters, digits, . _ -)")
    cwd = str(Path(a.cwd or entry.get("cwd") or ".").expanduser().resolve())
    if not Path(cwd).is_dir():
        die(f"cwd {cwd} doesn't exist")
    name = f"{entry.name}-{a.label}"
    if harness == "pi" and "--session-control" in a.agent_arg and pi_alias_live(name):
        die(f"pi session name '{name}' is in use by a running session (~/.pi/session-control/{name}.alias)")
    if (any(w.get("label") == a.label for w in worker_records(entry))
            or any(p.get("managed_label") == a.label for p in pane_rows(a.into))):
        die(f"label '{a.label}' is already used by a pane in {entry.name}")
    sid = mint_id() if harness in ("claude", "pi") else ""
    brief = write_brief(f"{entry.name}-{a.label}", a.brief_file)
    line = launch_line(harness, sid, a.model, a.effort, name, brief, a.agent_arg, a.command)
    if a.window:
        r = tmux("new-window", "-d", "-P", "-F", "#{pane_id}", "-t", f"={a.into}:", "-n", a.window, "-c", cwd)
    else:
        target = a.split or tmux("display-message", "-p", "-t", f"={a.into}:", "#{pane_id}").stdout.strip()
        owner = tmux("display-message", "-p", "-t", target, "#{session_name}").stdout.strip()
        if owner != a.into:
            die(f"split target {target} is not in requested session {a.into}")
        r = tmux("split-window", "-d", "-P", "-F", "#{pane_id}", "-t", target, "-c", cwd)
    pane_id = r.stdout.strip()

    def fn(reg):
        b = reg.block(entry.name)
        b.unset("auto")  # an attached worker must not disappear when the primary ends
        if sid:
            worker = dict(session_id=sid, harness=harness, cwd=cwd, label=a.label,
                          agent_args=json.dumps(a.agent_arg))
            worker.update({k: v for k, v in (("model", a.model), ("effort", a.effort)) if v})
            put_worker(b, worker)
        b.set("last_touched", now_str())
    mutate(fn)
    start_pane(pane_id, cwd, line, harness, sid, a.agent_arg, a.command or "", a.label,
               model=a.model, effort=a.effort)
    print(f"pane={pane_id}\nname={name}\nharness={harness}")
    report_start(pane_id, a.timeout)
    if harness == "codex":
        sid = record_pane_ids(entry.name).get(pane_id, "")
    if harness in AGENTS:
        print(f"session_id={sid or 'unknown'}")
        if not sid:
            print("WARNING: session ID unknown; use amx identify before shutdown", file=sys.stderr)
    else:
        print("resume=command-restart (not conversation resume)")


def cmd_rebuild(a):
    reg = Registry.load()
    entry = reg.block(a.id)
    rs_path = entry.get("resume_state")
    if not rs_path and worker_records(entry):
        die(f"{a.id} has worker records but no resume_state; recover its per-pane layout and commands "
            "before rebuilding, rather than silently restoring only the primary")
    if rs_path:
        rs = parse_resume_state(Path(rs_path).expanduser().read_text())
    elif harness_of(entry) == "command" and entry.get("command") and entry.get("cwd"):
        rs = {"fields": {}, "windows": [{"index": 1, "name": a.id, "layout": None, "panes": [
            {"index": 0, "cwd": entry.get("cwd"), "harness": "command", "command": entry.get("command")}]}]}
    elif entry.get("resumed_session_id") and entry.get("cwd"):
        # no layout recorded (wrapped, or registered by hand): one pane, primary only
        rs = {"fields": {}, "windows": [{"index": 1, "name": a.id, "layout": None, "panes": [
            {"index": 0, "cwd": entry.get("cwd"), "session_id": entry.get("resumed_session_id")}]}]}
    else:
        die(f"{a.id} has neither resume_state nor resumed_session_id + cwd")
    if not rs["windows"]:
        die(f"{rs_path} has no window blocks")
    session = a.id
    if has_session(session):
        die(f"tmux session '{session}' already exists; not overwriting")
    default_h = rs["fields"].get("harness") or harness_of(entry)
    saved_workers = {worker_key(w): w for w in worker_records(entry)}

    plan = []  # (window, [(pane, cwd, command)])
    problems = []
    for wi, w in enumerate(rs["windows"]):
        panes = []
        for p in w["panes"]:
            cwd = str(Path(p.get("cwd") or entry.get("cwd") or "~").expanduser())
            if not Path(cwd).is_dir():
                problems.append(f"window {w['index']} pane {p['index']}: cwd {cwd} missing")
            sid = p.get("session_id")
            h = p.get("harness") or default_h
            cmd = p.get("command", "")
            primary = p["primary"] == "true" if "primary" in p else wi == 0 and p is w["panes"][0]
            saved = entry.as_dict() if primary and h == harness_of(entry) else saved_workers.get((h, sid), {})
            args = agent_arguments(p.get("agent_args") or saved.get("agent_args"))
            effort = p.get("effort") or saved.get("effort")
            model = p.get("model") or saved.get("model")
            if not sid and cmd and p.get("harness") in AGENTS:
                problems.append(f"window {w['index']} pane {p['index']}: {h} command has no session_id; "
                                "record its native ID, or leave the pane as a shell and start a fresh agent explicitly")
            if sid:
                if h == "pi":
                    if not pi_transcript(cwd, sid):
                        problems.append(f"pi session {sid} not found under {pi_session_root() / pi_slug(cwd)} "
                                        f"with header cwd {cwd}; `pi --session-id` would start a blank session")
                    cmd = resume_line("pi", sid, agent_args=args)
                elif h in ("claude", "codex"):
                    nm = entry.name if primary else (f"{entry.name}-{p['label']}" if p.get("label") else None)
                    cmd = resume_line(h, sid, effort, nm, args)
                else:
                    problems.append(f"window {w['index']} pane {p['index']}: no resume adapter for {h}")
            panes.append((dict(p, harness=h, agent_args=json.dumps(args), effort=effort,
                               model=model, primary=primary), cwd, cmd))
        plan.append((w, panes))
    if problems:
        die("not rebuilding; fix these first:\n  " + "\n  ".join(problems))

    try:
        for wi, (w, panes) in enumerate(plan):
            first_cwd = panes[0][1] if panes else os.getcwd()
            if wi == 0:
                size = re.match(r"^[0-9a-f]+,(\d+)x(\d+),", w.get("layout") or "")
                dims = ["-x", size.group(1), "-y", size.group(2)] if size else []
                tmux("new-session", "-d", "-s", session, "-n", w["name"] or session, *dims, "-c", first_cwd)
                widx = tmux("list-windows", "-t", f"={session}", "-F", "#{window_index}").stdout.split()[-1]
            else:
                widx = tmux("new-window", "-d", "-P", "-F", "#{window_index}", "-t", f"={session}:",
                            "-n", w["name"] or "", "-c", first_cwd).stdout.strip()
            for _, cwd, _ in panes[1:]:
                tmux("split-window", "-d", "-t", f"={session}:{widx}", "-c", cwd)
            if w.get("layout") and len(panes) > 1:
                tmux("select-layout", "-t", f"={session}:{widx}", w["layout"])
            ids = tmux("list-panes", "-t", f"={session}:{widx}", "-F", "#{pane_id}").stdout.split()
            for pid, (p, cwd, cmd) in zip(ids, panes):
                tmux("set-option", "-p", "-t", pid, "@amx_primary", "1" if p["primary"] else "0")
                tmux("set-option", "-p", "-t", pid, "@amx_label", p.get("label", ""))
                if cmd and p.get("session_id"):
                    start_pane(pid, cwd, cmd, p["harness"], p["session_id"], agent_arguments(p["agent_args"]),
                               label=p.get("label", ""), model=p.get("model"), effort=p.get("effort"), primary=p["primary"])
                    wait_for_start(pid, 30)
                elif cmd:
                    start_pane(pid, cwd, launch_line("command", "", command=cmd), "command", "",
                               command=cmd, label=p.get("label", ""), primary=p["primary"])
                    wait_for_start(pid, 30)
    except CmError as error:
        failure = STATE / "snapshots" / f"{a.id}-rebuild-failed.txt"
        message = str(error).replace("; pane retained", "")
        try:
            snapshot_session(session, failure, 500)
            message += f"; failed rebuild output: {failure}"
        except (CmError, OSError):
            pass
        tmux("kill-session", "-t", f"={session}", check=False)
        die(message)

    def fn(reg):
        b = reg.block(a.id)
        b.set("tmux_session", session)
        sync_workers(b, inspect_panes(session, reg))
        for k in ("shutdown", "snapshot", "resume_state", "paused", "wrap_requested"):
            b.unset(k)
        b.set("last_touched", now_str())
    mutate(fn)
    print(f"rebuilt {session}: {len(plan)} window(s)")


def cmd_kill(a):
    if is_shared(a.session):
        die(f"{a.session} is shared (auto-named, or a manager runs there); not killing it")
    kill_session(a.session)


def kill_session(session):
    a = argparse.Namespace(session=session)
    if not has_session(a.session):
        die(f"no tmux session '{a.session}'")
    others = [s for s in list_sessions() if s != a.session]
    prefer = []
    for m in Registry.load().header.get_all("manager"):
        s = m.split()[0].split(":")[0]
        if s in others:
            prefer.append(s)
    dest = (prefer or others or [None])[0]
    clients = tmux("list-clients", "-t", f"={a.session}", "-F", "#{client_name}", check=False).stdout.split()
    if dest:
        for c in clients:
            if shutil.which("agent-deck"):
                r = run(["agent-deck", "switch", dest, c], check=False)
                if r.returncode != 0:
                    die(f"couldn't move client {c} off {a.session}: {r.stderr.strip()}; not killing")
            else:
                tmux("switch-client", "-c", c, "-t", f"={dest}", check=False)
    tmux("kill-session", "-t", f"={a.session}")
    print(f"killed {a.session}" + (f" (clients moved to {dest})" if dest and clients else ""))


