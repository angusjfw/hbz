def entry_state(d):
    if d.get("tmux_session"):
        return "paused" if d.get("paused") else "active"
    return "wrap_requested" if d.get("wrap_requested") else "shutdown" if d.get("shutdown") else "unknown"


def cmd_ls(a):
    for e in Registry.load().entries():
        d = e.as_dict()
        if (a.harness and a.harness not in entry_harnesses(e)) or (d.get("auto") and not a.all):
            continue
        busy = store(d["tmux_session"]).get("state", "") if d.get("tmux_session") else ""
        print("\t".join([e.name, harness_of(e), entry_state(d) + (" auto" if d.get("auto") else ""),
                         busy or "-", d.get("ticket") or "-", d.get("cwd") or "-",
                         ",".join(sorted(entry_harnesses(e)))]))


def read_log():
    try:
        lines = LOG.read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def cmd_log(a):
    recs = read_log()
    if a.removed is not None:
        rows = [r for r in reversed(recs) if r.get("event") == "removed"
                and (a.removed is True or r.get("entry") == a.removed)]
        for r in rows[:a.limit]:
            print("\t".join(str(v or "-") for v in
                            (r.get("ts"), r.get("how"), r.get("entry"), (r.get("fields") or {}).get("notes"))))
        return
    tracked = set()
    for r in recs:
        if r.get("event") == "removed" and r.get("tracked"):
            fields = r.get("fields") or {}
            if "session_keys" in r:
                tracked.update(tuple(key) for key in r["session_keys"])
            else:
                h = fields.get("harness") or "claude"
                tracked.update((h, sid) for sid in r.get("session_ids") or [])
                tracked.update(worker_key(parse_worker(w, h)) for w in fields.get("worker", []))
        elif r.get("tracked"):
            tracked.add((r.get("harness") or "claude", r.get("session_id")))
    reg = Registry.load()
    current = {key for e in reg.entries() for key in entry_keys(e)}
    for e in reg.entries():
        if not e.get("auto"):
            tracked.update(entry_keys(e))
    last = {}
    for r in recs:
        if r.get("session_id") and r.get("event") in ("start", "end"):
            last[(r.get("harness") or "claude", r["session_id"])] = r
    rows = sorted(last.values(), key=lambda r: r["ts"], reverse=True)
    if a.untracked:
        rows = [r for r in rows if (r.get("harness") or "claude", r["session_id"]) not in tracked | current
                and r.get("tmux_session") and not r.get("nested") and not is_shared(r["tmux_session"], reg)]
    for r in rows[:a.limit]:
        print("\t".join(str(r.get(k) or "-") for k in
                        ("ts", "event", "harness", "session_id", "tmux_session", "branch", "cwd")))


def cmd_track(a):
    reg = Registry.load()
    b = reg.block(a.id)
    if not b.get("auto"):
        die(f"{a.id} is already tracked")
    new = a.as_ or a.id
    ts = b.get("tmux_session")
    renamed = False
    if new != a.id:
        if reg.entry(new) or has_session(new):
            die(f"'{new}' is already an entry or a tmux session")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", new):
            die("name: letters, digits, . _ -")
        if ts and ts == a.id and has_session(ts) and not is_shared(ts, reg):
            tmux("rename-session", "-t", f"={ts}", new)
            agent_status("clear", ts)
            renamed = True

    def fn(reg):
        blk = reg.block(a.id)
        blk.unset("auto")
        if new != a.id:
            blk.name = new
            blk.lines[0] = f"## {new}"
            if renamed:
                blk.set("tmux_session", new)
        blk.set("last_touched", now_str())
    try:
        mutate(fn)
    except CmError:
        if renamed:
            tmux("rename-session", "-t", f"={new}", ts, check=False)
        raise
    print(f"tracking {new}" + (f" (tmux session renamed from {ts})" if renamed else ""))


def git_branch(cwd):
    try:
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"],
                           capture_output=True, text=True, timeout=2)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def sole_agent(pane_pid):
    """True if exactly one agent process sits between this process and the
    pane's shell. A nested agent (a `claude -p` run from a tool shell, a pi
    subagent) inherits TMUX_PANE but has its parent agent in the chain too."""
    procs = {pid: (ppid, args) for pid, ppid, _, args in ps_table()}
    pid, agents = os.getppid(), 0
    for _ in range(40):
        if pid == pane_pid:
            # tmux may run the agent directly rather than through an idle shell.
            return agents + (classify(procs.get(pid, (None, ""))[1]) in AGENTS) == 1
        if pid not in procs:
            return False
        ppid, args = procs[pid]
        if classify(args) in AGENTS:
            agents += 1
        pid = ppid
    return False


def cmd_hook(a):
    """Session hook: log the event and keep the registry in step. Never fails."""
    try:
        raw = sys.stdin.read()
        handle_hook(a.harness, json.loads(raw) if raw.strip() else {})
    except Exception as e:  # noqa: BLE001 - a hook must never break the agent
        try:
            STATE.mkdir(parents=True, exist_ok=True)
            with open(HOOK_ERRORS, "a") as f:
                f.write(f"{now_str()} {a.harness} {type(e).__name__}: {e}\n")
        except OSError:
            pass
    sys.exit(0)


def handle_hook(harness, ev):
    event = {"SessionStart": "start", "SessionEnd": "end"}.get(ev.get("hook_event_name"))
    if not event:
        return
    sid = ev.get("session_id")
    cwd = ev.get("cwd") or os.getcwd()
    pane = os.environ.get("TMUX_PANE") if os.environ.get("TMUX") else None
    rows = pane_rows() if pane else []
    row = next((r for r in rows if r["pane_id"] == pane), None)
    session = row["session"] if row else None
    nested = bool(row) and not sole_agent(row["pane_pid"])
    rec = {"event": event, "harness": harness, "session_id": sid, "cwd": cwd, "tmux_session": session,
           "pane": pane, "branch": git_branch(cwd), "source": ev.get("source") or ev.get("reason")}
    if nested:
        rec["nested"] = True
    if not row or not sid or nested or is_shared(session) or row.get("managed_harness") == "command":
        append_log(rec)
        return
    session_rows = [r for r in rows if r["session"] == session]
    primary = primary_pane(row, session_rows)
    reason = ev.get("reason") or ""
    changed_harness = bool(row.get("managed_harness")) and row["managed_harness"] != harness

    def fn(reg):
        entries = reg.by_tmux_session(session)
        if len(entries) > 1:
            return None
        b = entries[0] if entries else None
        if event == "start":
            if b is None:
                if not primary or reg.entry(session):
                    return None  # don't guess a parent's harness or revive a shut-down entry
                b = reg.new(session)
                apply_assign(b, ["started=now", "auto=true", f"harness={harness}", f"tmux_session={session}",
                                 f"cwd={cwd}"])
            if primary:
                set_primary_harness(b, harness)
                b.set("resumed_session_id", sid)
            else:
                old_key = (row.get("managed_harness") or harness, row.get("managed_id"))
                old = next((w for w in worker_records(b) if worker_key(w) == old_key), {})
                if old and old_key != (harness, sid):
                    drop_worker(b, old["session_id"], old["harness"])
                settings = {"model", "effort", "agent_args"}
                worker = {key: value for key, value in old.items() if not changed_harness or key not in settings}
                worker.update(session_id=sid, harness=harness, cwd=cwd)
                for key, source in (("label", "managed_label"), ("model", "managed_model"),
                                    ("effort", "managed_effort"), ("agent_args", "agent_args")):
                    if row.get(source) and not (changed_harness and key in settings):
                        worker[key] = row[source]
                put_worker(b, worker)
            b.set("last_touched", now_str())
        elif b and reason != "clear":
            if primary and harness_of(b) == harness and b.get("auto") and b.get("resumed_session_id") == sid:
                if len(session_rows) == 1 and not worker_records(b):
                    log_removed(b, "auto-end")
                    reg.remove(b.name)
                    return b.name
                b.unset("auto")  # other panes still belong to this container
            if not primary:
                drop_worker(b, sid, harness)
            b.set("last_touched", now_str())
        return b.name if b else None
    name = mutate(fn)
    rec["entry"] = name
    if name:
        e = Registry.load().entry(name)
        rec["tracked"] = bool(e) and not e.get("auto")
        if event == "start" and e:
            if changed_harness:
                clear_pane_settings(pane)
            # Keep each pane's identity and role current, regardless of the entry default.
            for key, value in (("session_id", sid), ("harness", harness), ("primary", "1" if primary else "0")):
                tmux("set-option", "-p", "-t", pane, f"@amx_{key}", value, check=False)
    append_log(rec)


def cmd_migrate(a):
    """Move ~/.local/state/claude-manager to the amx state dir. Idempotent."""
    old_reg = OLD_STATE / "sessions.md"
    if not OLD_STATE.exists():
        print("nothing to migrate")
        return
    if REGISTRY.exists() and old_reg.exists():
        die(f"both {old_reg} and {REGISTRY} exist; merge them by hand")
    old_lock = OLD_STATE / "sessions.md.lock"
    start = time.time()
    while True:
        try:
            os.mkdir(old_lock)
            break
        except FileExistsError:
            if time.time() - start > LOCK_TIMEOUT:
                die(f"old registry lock {old_lock} is held")
            time.sleep(0.1)
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        for child in OLD_STATE.iterdir():
            if child.name == "sessions.md.lock" or child.name.startswith("watch."):
                continue
            dst = STATE / child.name
            if dst.exists():
                die(f"{dst} already exists; not overwriting")
            os.rename(child, dst)
        if REGISTRY.exists():
            text = REGISTRY.read_text()
            for old, new in ((str(OLD_STATE), str(STATE)),
                             ("~/.local/state/claude-manager", "~/.local/state/amx")):
                text = text.replace(old, new)
            reg = Registry(text)
            reg.header.unset("manager")
            REGISTRY.write_text(reg.text())
    finally:
        os.rmdir(old_lock)
    for pf in OLD_STATE.glob("watch.*.pid"):
        pf.unlink()
    try:
        OLD_STATE.rmdir()
    except OSError:
        print(f"left {OLD_STATE} in place: not empty", file=sys.stderr)
    for e in Registry.load().entries():
        ts = e.get("tmux_session")
        if ts and e.get("paused") and has_session(ts):
            tmux("set-option", "-t", f"={ts}:", "@amx_paused", "1", check=False)
            tmux("set-option", "-u", "-t", f"={ts}:", "@cm_paused", check=False)
    print(f"migrated {OLD_STATE} to {STATE}")


