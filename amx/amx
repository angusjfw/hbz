NATIVE = {"claude": "SendMessage", "pi": "send_to_session"}


class Refused(CmError):
    """amx msg declined to deliver. The reason word is for callers to branch on."""

    def __init__(self, reason, detail):
        super().__init__(f"refused {reason}: {detail}")
        self.reason = reason


def msg_route(sender, target, via, live):
    """'socket' or 'pane' for this pair; Refused when neither should be used.
    live: the target is pi and its session-control socket answers."""
    h, name = target["harness"], target["name"]
    if target["dead"]:
        raise Refused("dead", f"{name} ({target['pane_id']}) has exited")
    if h == "command":
        raise Refused("command", f"{name} is not a chat agent; type into it with tmux-interaction if you mean to")
    if via == "socket":
        if h == "pi" and live:
            return "socket"
        raise Refused("no-socket", f"no live session-control socket for {name}")
    if via == "auto" and sender and sender["harness"] == h and (h == "claude" or (h == "pi" and live)):
        raise Refused("native", f"use {NATIVE[h]} to reach {name} (or --via pane)")
    return "socket" if via == "auto" and h == "pi" and live else "pane"


def msg_header(sender):
    if not sender:
        return "[from an agent outside tmux; no reply route]"
    name = sender["name"]
    return f'[from {name} ({sender["harness"]}, {sender["pane_id"]}); reply: amx msg {name} "..."]'


def compose(sender, route, body):
    """pi replies to pi through sender_info; everyone else reads the header."""
    if route == "socket" and sender and sender["harness"] == "pi" and sender.get("session_id"):
        return f"{body}\n\n<sender_info>{json.dumps({'sessionId': sender['session_id']})}</sender_info>"
    return f"{msg_header(sender)}\n{body}"


