FIELD_RE = re.compile(r"^([a-z_][a-z0-9_]*):(?: (.*))?$")
REPEATABLE = {"worker", "manager"}


class CmError(Exception):
    pass


def die(msg):
    raise CmError(msg)


# ---------------------------------------------------------------- registry

class Block:
    """A run of registry lines: the header (before the first `## `) or one entry."""

    def __init__(self, name, lines):
        self.name = name  # None for the header
        self.lines = lines  # includes the `## name` line for entries

    def body_start(self):
        return 0 if self.name is None else 1

    def fields(self):
        """Yield (index, key, value) for field lines."""
        for i in range(self.body_start(), len(self.lines)):
            m = FIELD_RE.match(self.lines[i])
            if m:
                yield i, m.group(1), m.group(2) or ""

    def get(self, key):
        for _, k, v in self.fields():
            if k == key:
                return v
        return None

    def get_all(self, key):
        return [v for _, k, v in self.fields() if k == key]

    def as_dict(self):
        d = {}
        for _, k, v in self.fields():
            if k in REPEATABLE:
                d.setdefault(k, []).append(v)
            elif k not in d:
                d[k] = v
        return d

    def _insert_at(self):
        idx = [i for i, _, _ in self.fields()]
        if idx:
            return idx[-1] + 1
        if self.name is None:
            # header: after the `# ...` title and one blank line
            for i, line in enumerate(self.lines):
                if line.startswith("# "):
                    j = i + 1
                    if j < len(self.lines) and self.lines[j].strip() == "":
                        j += 1
                    if j == len(self.lines) or self.lines[j].strip() != "":
                        self.lines.insert(j, "")
                    return j
            return len(self.lines)
        return 1

    def set(self, key, value):
        for i, k, _ in self.fields():
            if k == key:
                self.lines[i] = f"{key}: {value}"
                return
        self.lines.insert(self._insert_at(), f"{key}: {value}")

    def append(self, key, value):
        idx = [i for i, k, _ in self.fields() if k == key]
        at = idx[-1] + 1 if idx else self._insert_at()
        self.lines.insert(at, f"{key}: {value}")

    def unset(self, key, match=None):
        """Remove lines for key. With match, only lines whose value equals it
        or whose first word equals it. Returns the number removed."""
        drop = []
        for i, k, v in self.fields():
            if k != key:
                continue
            if match is None or v == match or (v.split() or [""])[0] == match:
                drop.append(i)
        for i in reversed(drop):
            del self.lines[i]
        return len(drop)


class Registry:
    def __init__(self, text):
        lines = text.split("\n")
        trailing_newline = text.endswith("\n")
        if trailing_newline:
            lines = lines[:-1]
        self.trailing_newline = trailing_newline or not text
        self.blocks = []
        cur = Block(None, [])
        for line in lines:
            if line.startswith("## "):
                self.blocks.append(cur)
                cur = Block(line[3:].strip(), [line])
            else:
                cur.lines.append(line)
        self.blocks.append(cur)

    @classmethod
    def load(cls, path=None):
        path = path or REGISTRY
        if not path.exists():
            return cls("# Sessions\n")
        return cls(path.read_text())

    def text(self):
        out = "\n".join(line for b in self.blocks for line in b.lines)
        return out + ("\n" if self.trailing_newline else "")

    @property
    def header(self):
        return self.blocks[0]

    def entries(self):
        return [b for b in self.blocks[1:]]

    def entry(self, name):
        for b in self.blocks[1:]:
            if b.name == name:
                return b
        return None

    def block(self, name):
        if name == "@header":
            return self.header
        b = self.entry(name)
        if b is None:
            die(f"no registry entry '{name}' (have: {', '.join(e.name for e in self.entries()) or 'none'})")
        return b

    def new(self, name):
        if self.entry(name):
            die(f"registry entry '{name}' already exists")
        last = self.blocks[-1]
        b = Block(name, [f"## {name}"])
        if last.lines and last.lines[-1].strip() != "":
            last.lines.append("")
        self.blocks.append(b)
        return b

    def remove(self, name):
        b = self.block(name)
        self.blocks.remove(b)

    def by_tmux_session(self, session):
        return [e for e in self.entries() if e.get("tmux_session") == session]


def harness_of(entry):
    return (entry.get("harness") or "claude").strip()


def parse_worker(value, default_harness="claude"):
    """Worker values use shell quoting; legacy records inherit the entry harness."""
    try:
        # Old writers did not quote paths: apostrophes/backslashes were literal.
        parts = shlex.split(value) if re.search(r"(?:^|\s)harness=", value) else value.split()
    except ValueError as error:
        die(f"invalid worker record: {error}")
    if not parts:
        die("empty worker record")
    fields = dict(part.split("=", 1) for part in parts[1:] if "=" in part)
    return dict(fields, session_id=parts[0], harness=fields.get("harness") or default_harness)


def worker_records(entry):
    return [parse_worker(value, harness_of(entry)) for value in entry.get_all("worker")]


def worker_key(worker):
    return worker["harness"], worker["session_id"]


def format_worker(worker):
    fields = [worker["session_id"]]
    keys = ["harness", "cwd", "label", "model", "effort", "agent_args"]
    keys += sorted(set(worker) - set(keys) - {"session_id"})
    fields += [f"{key}={worker[key]}" for key in keys if worker.get(key) is not None]
    if any("\n" in value or "\r" in value for value in fields):
        die("worker fields must be single lines")
    return shlex.join(fields)


def drop_worker(entry, sid, harness=None):
    matches = [(i, parse_worker(value, harness_of(entry))) for i, key, value in entry.fields()
               if key == "worker" and parse_worker(value, harness_of(entry))["session_id"] == sid]
    matches = [(i, worker) for i, worker in matches if not harness or worker["harness"] == harness]
    if len({worker_key(worker) for _, worker in matches}) > 1:
        die(f"worker ID {sid} is ambiguous in {entry.name}; pass --harness")
    for i, _ in reversed(matches):
        del entry.lines[i]
    return bool(matches)


def put_worker(entry, worker):
    """Upsert one harness-scoped identity, preserving fields the caller didn't supply."""
    if worker["harness"] not in AGENTS:
        die(f"no agent adapter for worker harness '{worker['harness']}'")
    if "agent_args" in worker:
        agent_arguments(worker["agent_args"])
    have = worker_records(entry)
    old = next((w for w in have if worker_key(w) == worker_key(worker)), {})
    merged = {**old, **worker}
    label = merged.get("label")
    if label and any(w.get("label") == label and worker_key(w) != worker_key(worker) for w in have):
        die(f"label '{label}' is already used in {entry.name}")
    value = format_worker(merged)
    for i, key, raw in entry.fields():
        if key == "worker" and worker_key(parse_worker(raw, harness_of(entry))) == worker_key(worker):
            entry.lines[i] = f"worker: {value}"
            return
    entry.append("worker", value)


def set_primary_harness(entry, harness):
    if harness_of(entry) != harness:
        # Freeze inherited worker harnesses before changing their default.
        workers = worker_records(entry)
        for worker in workers:
            put_worker(entry, worker)
        for key in ("model", "effort", "agent_args", "command"):
            entry.unset(key)
    entry.set("harness", harness)


def agent_arguments(value):
    try:
        args = json.loads(value or "[]")
    except ValueError:
        die("agent_args must be a JSON array of strings")
    if not isinstance(args, list) or not all(isinstance(arg, str) for arg in args):
        die("agent_args must be a JSON array of strings")
    return args


def acquire_lock(timeout=LOCK_TIMEOUT):
    STATE.mkdir(parents=True, exist_ok=True)
    start = time.time()
    while True:
        try:
            os.mkdir(LOCK)
            return
        except FileExistsError:
            if time.time() - start > timeout:
                try:
                    age = int(time.time() - LOCK.stat().st_mtime)
                except OSError:
                    age = -1
                die(f"registry lock {LOCK} held for >{timeout:.0f}s (lock age {age}s). "
                    f"If no amx or agent is writing, remove it with: rmdir {LOCK}")
            time.sleep(0.1)


def release_lock():
    try:
        os.rmdir(LOCK)
    except FileNotFoundError:
        pass


def write_registry(reg):
    tmp = REGISTRY.with_name(REGISTRY.name + ".tmp")
    tmp.write_text(reg.text())
    os.replace(tmp, REGISTRY)
    try:
        # replace rather than write through, so a symlink here can't redirect it
        tmpw = LAST_WRITER.with_name(LAST_WRITER.name + ".tmp")
        tmpw.write_text((os.environ.get("TMUX_PANE") or my_pane_quiet() or "") + "\n")
        os.replace(tmpw, LAST_WRITER)
    except OSError:
        pass


def mutate(fn):
    """Run fn(reg) under the lock on a fresh read, then write."""
    acquire_lock()
    try:
        reg = Registry.load()
        result = fn(reg)
        write_registry(reg)
        return result
    finally:
        release_lock()


def now_str():
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def expand_value(v):
    if v == "now":
        return now_str()
    if v == "today":
        return datetime.now().strftime("%Y-%m-%d")
    return v


def parse_assignment(a):
    m = re.match(r"^([a-z_][a-z0-9_]*)(\+?=)(.*)$", a, re.S)
    if not m:
        die(f"bad assignment '{a}': expected key=value or key+=value")
    key, op, val = m.groups()
    if "\n" in val:
        die(f"value for {key} contains a newline; registry values are single lines")
    return key, op, expand_value(val)


# ---------------------------------------------------------------- tmux / processes

def run(cmd, check=True, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if check and r.returncode != 0:
        die(f"{' '.join(shlex.quote(c) for c in cmd)} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r


def tmux(*args, check=True):
    return run(["tmux", *args], check=check)


def has_session(name):
    return tmux("has-session", "-t", f"={name}", check=False).returncode == 0


def list_sessions():
    r = tmux("list-sessions", "-F", "#{session_name}", check=False)
    return r.stdout.split() if r.returncode == 0 else []


def ps_table():
    r = run(["ps", "-ax", "-o", "pid=,ppid=,tty=,args="], check=False)
    rows = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3:
            continue
        pid, ppid, tty = parts[0], parts[1], parts[2]
        args = parts[3].strip() if len(parts) > 3 else ""
        rows.append((int(pid), int(ppid), tty, args))
    return rows


def pane_rows(target=None):
    fmt = "\t".join(["#{session_name}", "#{window_index}", "#{window_name}", "#{window_layout}",
                     "#{pane_index}", "#{pane_id}", "#{pane_pid}", "#{pane_tty}",
                     "#{pane_current_path}", "#{pane_title}", "#{pane_dead}", "#{pane_dead_status}",
                     "#{@amx_harness}", "#{@amx_session_id}", "#{@amx_agent_args}",
                     "#{@amx_command}", "#{@amx_label}", "#{@amx_launch_cwd}",
                     "#{@amx_model}", "#{@amx_effort}", "#{@amx_primary}"])
    args = ["list-panes", "-F", fmt]
    args += ["-s", "-t", f"={target}:"] if target else ["-a"]
    r = tmux(*args, check=False)
    if r.returncode != 0:
        if target:
            die(f"no tmux session '{target}'")
        return []
    rows = []
    for line in r.stdout.splitlines():
        f = line.split("\t")
        rows.append(dict(session=f[0], window=int(f[1]), window_name=f[2], layout=f[3],
                         pane=int(f[4]), pane_id=f[5], pane_pid=int(f[6]),
                         tty=f[7].replace("/dev/", ""), cwd=f[8], title=f[9], dead=f[10] == "1",
                         exit_status=f[11], managed_harness=f[12], managed_id=f[13], agent_args=f[14],
                         managed_command=f[15], managed_label=f[16], launch_cwd=f[17],
                         managed_model=f[18], managed_effort=f[19], managed_primary=f[20]))
    return rows


def my_pane_quiet():
    try:
        return whoami_pane()
    except CmError:
        return None


def whoami_pane():
    """Own pane id: $TMUX_PANE if it resolves, else walk process ancestry."""
    tp = os.environ.get("TMUX_PANE")
    panes = pane_rows()
    if tp and any(p["pane_id"] == tp for p in panes):
        return tp
    by_pid = {p["pane_pid"]: p["pane_id"] for p in panes}
    parents = {pid: ppid for pid, ppid, _, _ in ps_table()}
    pid = os.getpid()
    for _ in range(20):
        if pid in by_pid:
            return by_pid[pid]
        pid = parents.get(pid)
        if not pid or pid == 1:
            break
    die("can't resolve own tmux pane ($TMUX_PANE empty or stale, and no pane in process ancestry)")


# ---------------------------------------------------------------- harness adapter

# Built-in adapters. Unknown CLIs can use command sessions without pretending
# that restarting their command resumes an agent conversation.
AGENTS = {
    "claude": re.compile(r"(^|/)claude(-code)?( |$)|node\b.*\bclaude"),
    "pi": re.compile(r"^pi\s*$|^pi |(^|/)bin/pi( |$)|node\b.*pi-coding-agent"),
    "codex": re.compile(r"(^|/)codex( |$)|node\b.*(?:@openai/codex|/bin/codex)"),
}
HARNESSES = (*AGENTS, "command")
UUID_RE = re.compile(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}")
CODEX_TITLE_CONFIG = 'tui.terminal_title=["session-id"]'


def classify(args):
    if not args:
        return "idle"
    for harness, pattern in AGENTS.items():
        if pattern.search(args):
            return harness
    return "cmd"


SHELLS = {"sh", "bash", "zsh", "fish", "dash", "ksh", "tcsh", "csh", "nu"}


def is_shell(args):
    if not args:
        return True
    first = args.split()[0]
    return os.path.basename(first.lstrip("-")) in SHELLS


def argv_session_id(args):
    m = re.search(r"--(?:session-id|resume)[ =]([A-Za-z0-9._-]+)", args)
    return m.group(1) if m else None


def launch_line(harness, sid, model=None, effort=None, name=None, brief=None, agent_args=(), command=None):
    if harness == "claude":
        parts = ["claude", "--session-id", sid]
        if model:
            parts += ["--model", model]
        if effort:
            parts += ["--effort", effort]
        if name:
            parts += ["--name", name]
    elif harness == "pi":
        parts = ["pi", "--session-id", sid]
        if model:
            parts += ["--model", model]
        if effort:
            parts += ["--thinking", effort]
        if name:
            parts += ["--name", name]
    elif harness == "codex":
        parts = ["codex", "-c", CODEX_TITLE_CONFIG]
        if model:
            parts += ["--model", model]
        if effort:
            parts += ["-c", f"model_reasoning_effort={json.dumps(effort)}"]
    elif harness == "command":
        if not command:
            die("command sessions need --command")
        return shlex.join(["/bin/sh", "-c", command])
    else:
        die(f"unknown harness '{harness}'")
    parts += list(agent_args)
    line = " ".join(shlex.quote(p) for p in parts)
    if brief:
        line += f' "$(cat {shlex.quote(str(brief))})"'
    return line


def resume_line(harness, sid, effort=None, name=None, agent_args=()):
    if harness == "claude":
        # Claude doesn't restore --name on resume, and the name is its address
        parts = ["claude"] + (["--effort", effort] if effort else []) + ["--resume", sid]
        if name:
            parts += ["--name", name]
    elif harness == "pi":
        # pi restores model, thinking level and --name itself
        parts = ["pi", "--session-id", sid]
    elif harness == "codex":
        parts = ["codex", "resume", sid, "-c", CODEX_TITLE_CONFIG]
        if effort:
            parts += ["-c", f"model_reasoning_effort={json.dumps(effort)}"]
    else:
        die(f"harness '{harness}' has no conversation resume adapter")
    return " ".join(shlex.quote(p) for p in [*parts, *agent_args])


def claude_project_dir(cwd):
    return Path.home() / ".claude/projects" / re.sub(r"[/._]", "-", cwd)


def pi_agent_dir():
    return Path(os.environ.get("PI_CODING_AGENT_DIR", Path.home() / ".pi/agent")).expanduser()


def pi_settings():
    p = pi_agent_dir() / "settings.json"
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return {}


def pi_session_root():
    if os.environ.get("PI_CODING_AGENT_SESSION_DIR"):
        return Path(os.environ["PI_CODING_AGENT_SESSION_DIR"]).expanduser()
    sd = pi_settings().get("sessionDir")
    if sd:
        return Path(sd).expanduser()
    return pi_agent_dir() / "sessions"


def pi_slug(cwd):
    return "--" + re.sub(r"[/\\:]", "-", cwd.lstrip("/")) + "--"


def pi_header(path):
    try:
        with open(path) as f:
            return json.loads(f.readline())
    except (OSError, ValueError):
        return {}


def transcript_files(harness, cwd):
    """(path, session_id) pairs for transcripts recorded in cwd."""
    cwd = str(Path(cwd).expanduser())
    out = []
    if harness == "claude":
        d = claude_project_dir(cwd)
        for p in d.glob("*.jsonl") if d.is_dir() else []:
            out.append((p, p.stem))
    elif harness == "pi":
        d = pi_session_root() / pi_slug(cwd)
        for p in d.glob("*.jsonl") if d.is_dir() else []:
            h = pi_header(p)
            if h.get("cwd") == cwd:
                out.append((p, h.get("id") or p.stem.split("_", 1)[-1]))
    elif harness == "codex":
        home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
        for root in (home / "sessions", home / "archived_sessions"):
            for p in root.rglob("*.jsonl") if root.is_dir() else []:
                header = pi_header(p)
                meta = header.get("payload", {}) if header.get("type") == "session_meta" else {}
                if meta.get("cwd") == cwd and meta.get("id"):
                    out.append((p, meta["id"]))
    return out


def codex_title_prefix(title):
    title = title.strip()
    if UUID_RE.fullmatch(title):
        return title
    # Codex truncates the native session-id title item to 29 chars + '...'.
    if re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{5}\.\.\.", title):
        return title[:-3]
    return None


def codex_ids(cwd, prefix):
    """Resolve only native IDs with this prefix and cwd, never newest-by-time."""
    home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser()
    db_home = Path(os.environ.get("CODEX_SQLITE_HOME", home)).expanduser()
    ids = set()
    for db_path in db_home.glob("state_*.sqlite"):
        try:
            with closing(sqlite3.connect(f"{db_path.resolve().as_uri()}?mode=ro", uri=True, timeout=0.2)) as db:
                rows = db.execute("SELECT id FROM threads WHERE cwd = ? AND id LIKE ?", (cwd, prefix + "%"))
                ids.update(row[0] for row in rows if UUID_RE.fullmatch(row[0]))
        except sqlite3.Error:
            pass  # Other versions/storage layouts can still have rollout files.
    for root in (home / "sessions", home / "archived_sessions"):
        for path in root.rglob(f"*{prefix}*.jsonl") if root.is_dir() else []:
            header = pi_header(path)
            meta = header.get("payload", {}) if header.get("type") == "session_meta" else {}
            sid = meta.get("id", "")
            if meta.get("cwd") == cwd and UUID_RE.fullmatch(sid) and sid.startswith(prefix):
                ids.add(sid)
    return ids


def codex_pane_id(row):
    """Native per-pane title, optionally resolved against persisted native IDs."""
    prefix = codex_title_prefix(row.get("title", ""))
    if not prefix:
        return None
    if UUID_RE.fullmatch(prefix):
        return prefix
    ids = codex_ids(row["cwd"], prefix)
    # A known full launch/resume ID can resolve an otherwise unpersisted thread.
    known_id = row.get("managed_id") or ""
    if known_id.startswith(prefix) and UUID_RE.fullmatch(known_id):
        ids.add(known_id)
    return next(iter(ids)) if len(ids) == 1 else None


def pi_transcript(cwd, sid):
    for p, s in transcript_files("pi", cwd):
        if s == sid:
            return p
    return None


def pi_alias_live(name):
    """True if a running pi session holds this --name. pi leaves aliases and
    sockets behind when killed, so an alias only counts if its socket answers."""
    import socket
    alias = Path.home() / ".pi/session-control" / f"{name}.alias"
    try:
        target = alias.resolve(strict=True)
    except (OSError, RuntimeError):
        return False
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1)
    try:
        s.connect(str(target))
        return True
    except OSError:
        return False
    finally:
        s.close()


def pi_session_names(path):
    names = []
    try:
        with open(path) as f:
            for line in f:
                if '"session_info"' in line:
                    try:
                        e = json.loads(line)
                    except ValueError:
                        continue
                    if e.get("type") == "session_info" and e.get("name"):
                        names.append(e["name"])
    except OSError:
        pass
    return names


# ---------------------------------------------------------------- agent-status store

def store(session):
    try:
        return json.loads((AGENT_STATUS / f"{session}.json").read_text())
    except (OSError, ValueError):
        return {}


def store_by_pane(session):
    return {v.get("pane_id"): (sid, v.get("state")) for sid, v in store(session).get("claudes", {}).items()}


# ---------------------------------------------------------------- panes

def primary_pane(row, rows):
    if row.get("managed_primary") in ("0", "1"):
        return row["managed_primary"] == "1"
    if row.get("managed_label"):
        return False
    marked = [r for r in rows if r.get("managed_primary") == "1"]
    if marked:
        return row["pane_id"] == marked[0]["pane_id"]
    first_window = min((r["window"] for r in rows), default=None)
    return row["window"] == first_window and row["pane"] == 0


def previous_worker(workers, pane):
    """Recover settings by bound identity or unique label, never infer an ID."""
    harness = pane["kind"]
    for sid in (pane.get("session_id"), pane.get("managed_id")):
        if (harness, sid) in workers:
            return workers[harness, sid]
    label = pane.get("label") or pane.get("managed_label")
    matches = [w for w in workers.values() if w["harness"] == harness and label and w.get("label") == label]
    return matches[0] if len(matches) == 1 else {}


def unresolved_workers(workers, panes):
    """Last-known records bound to unresolved agents or labelled recovery shells."""
    retained = {}
    for pane in panes:
        worker = {}
        if pane["kind"] in AGENTS and not pane["session_id"]:
            worker = previous_worker(workers, pane)
        elif pane["kind"] == "idle" and pane.get("label"):
            matches = [w for w in workers.values() if w.get("label") == pane["label"]]
            if len(matches) == 1:
                worker = matches[0]
        if worker:
            retained[worker_key(worker)] = pane
    return retained


def inspect_panes(session, reg=None):
    reg = reg or Registry.load()
    rows = pane_rows(session)
    procs = ps_table()
    entries = reg.by_tmux_session(session)
    entry = entries[0] if len(entries) == 1 else None
    st = store_by_pane(session)
    workers = {worker_key(w): w for w in worker_records(entry)} if entry else {}
    out = []
    tty_of = {pid: tty for pid, _, tty, _ in procs}
    for r in rows:
        fg = ""
        # compare ps with ps: macOS ps abbreviates ttys (s003 for /dev/ttys003)
        pane_tty = tty_of.get(r["pane_pid"], r["tty"])
        for pid, ppid, tty, args in procs:
            if ppid == r["pane_pid"] and tty == pane_tty:
                fg = args
                break
        own = next((a for pid, _, _, a in procs if pid == r["pane_pid"]), "")
        if classify(own) in AGENTS or (not fg and not is_shell(own)):
            fg = own
        managed = r.get("managed_harness")
        # A tool/subagent child cannot contradict an opaque managed parent's type.
        observed = classify(own) if managed in AGENTS and not is_shell(own) else classify(fg)
        conflict = managed in AGENTS and observed in AGENTS and managed != observed
        kind = observed if conflict else (managed or observed)
        if kind == "command":
            kind, fg = "cmd", r.get("managed_command") or fg
        sid, src = None, None
        primary = primary_pane(r, rows)
        primary_entry = entry if primary and entry and harness_of(entry) == kind else None
        if kind in AGENTS:
            store_sid = st.get(r["pane_id"], (None, None))[0] if kind != "codex" else None
            known_sid = (r.get("managed_id", "") if not conflict else "") or (primary_entry.get("resumed_session_id") if primary_entry else None)
            if kind == "codex" and not known_sid:
                prefix = codex_title_prefix(r.get("title", ""))
                matches = [wid for h, wid in workers if h == kind and prefix and wid.startswith(prefix)]
                if len(matches) == 1:
                    known_sid = matches[0]
            native_sid = codex_pane_id(dict(r, managed_id=known_sid)) if kind == "codex" else None
            if native_sid:
                sid, src = native_sid, "native-title"
            elif kind == "codex" and codex_title_prefix(r.get("title", "")):
                pass  # Unresolved/ambiguous current title must not fall back to an old ID.
            elif r.get("managed_id") and not conflict:
                sid, src = r["managed_id"], "pane"
            elif kind != "codex" and primary_entry and primary_entry.get("resumed_session_id") and not conflict:
                sid, src = primary_entry.get("resumed_session_id"), "registry"
            elif store_sid and (kind, store_sid) in workers:
                sid, src = store_sid, "registry"
            elif store_sid:
                sid, src = store_sid, "store"
            elif kind in ("claude", "pi") and argv_session_id(fg):
                sid = argv_session_id(fg)
                src = "registry" if (kind, sid) in workers else "argv"
            elif kind == "codex" and (match := re.search(r"\bcodex\s+resume\s+(" + UUID_RE.pattern + r")\b", fg)):
                sid, src = match.group(1), "argv"
        saved = primary_entry.as_dict() if primary_entry else previous_worker(workers, dict(r, kind=kind, session_id=sid))
        if conflict:
            saved = {}
        label = r.get("managed_label") or saved.get("label")
        name = (entry.name if primary else f"{entry.name}-{label}" if label else None) if entry else None
        out.append(dict(r, kind=kind, command=fg, session_id=sid, id_source=src,
                        primary=primary, state=st.get(r["pane_id"], (None, None))[1], label=label,
                        name=name or r["pane_id"], entry=entry.name if entry else None,
                        entry_harness=harness_of(entry) if entry else None, harness_conflict=conflict,
                        model=r.get("managed_model") or saved.get("model"),
                        effort=r.get("managed_effort") or saved.get("effort"),
                        agent_args=r.get("agent_args") or saved.get("agent_args") or "[]"))
    return out


