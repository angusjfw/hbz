def snapshot_session(session, out, lines):
    a = argparse.Namespace(session=session, out=out, lines=lines)
    out = Path(a.out).expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    chunks = []
    panes = inspect_panes(a.session)
    for p in panes:
        t = p["pane_id"]
        cap = tmux("capture-pane", "-p", "-J", "-t", t, "-S", f"-{a.lines}", check=False).stdout
        chunks.append(f"--- window {p['window']} pane {p['pane']} ({p['kind']}"
                      f"{' ' + p['session_id'] if p['session_id'] else ''}) ---\n{cap.rstrip()}")
        if p["kind"] == "claude" and INPUT_BOX.exists():
            box = run([str(INPUT_BOX), t], check=False).stdout.strip() or "unknown"
            chunks.append(f"--- input box: {box} ---")
        chunks.append("")
    out.write_text("\n".join(chunks) + "\n")
    return panes


