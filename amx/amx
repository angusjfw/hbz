def pane_identity(pane):
    """Shared routing view. Transport availability must be checked at delivery."""
    return dict(name=pane["name"], pane_id=pane["pane_id"], tmux_session=pane["session"],
                address=f"{pane['session']}:{pane['window']}.{pane['pane']}",
                entry=pane["entry"], entry_harness=pane["entry_harness"],
                harness=pane["kind"] if pane["kind"] in AGENTS else "command",
                session_id=pane["session_id"], cwd=pane["cwd"], primary=pane["primary"],
                label=pane["label"], model=pane["model"], effort=pane["effort"],
                agent_args=agent_arguments(pane["agent_args"]), dead=pane.get("dead", False),
                harness_conflict=pane["harness_conflict"], state=pane["state"])


def resolve_target(target):
    """Resolve an amx name or explicit pane ID. Never guess between aliases."""
    reg = Registry.load()
    rows = pane_rows()
    explicit = re.fullmatch(r"%\d+", target)
    sessions = {r["session"] for r in rows if not explicit or r["pane_id"] == target}
    matches = []
    for session in sorted(sessions):
        entries = reg.by_tmux_session(session)
        for pane in inspect_panes(session, reg):
            if (pane["pane_id"] if explicit else pane["name"]) == target:
                if len(entries) > 1:
                    die(f"several entries have tmux_session {session}; fix the registry first")
                matches.append(pane_identity(pane))
    if len(matches) > 1:
        die(f"ambiguous target '{target}'; use a pane ID: " + ", ".join(p["pane_id"] for p in matches))
    if not matches:
        die(f"no live pane for '{target}'; use an amx name or explicit %pane ID")
    return matches[0]


def print_identity(info, as_json):
    if as_json:
        print(json.dumps(info))
    else:
        for key, value in info.items():
            print(f"{key}={value if value is not None else ''}")


def cmd_resolve(a):
