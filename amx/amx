SWITCHER = ("choose-tree -Zw -F '#{?session_format,#{?#{@amx_paused},⏸ paused · ,}#{session_windows}w"
            "#{?session_attached, (attached),},#{?window_format,#{window_name}#{window_flags},"
            "#{pane_current_command}}}'")


def install_switcher():
    """prefix+w with a paused badge. Global, and gone after a server restart."""
    tmux("bind-key", "w", *shlex.split(SWITCHER), check=False)


def live_entry(reg, name):
    e = reg.block(name)
    ts = e.get("tmux_session")
    if not ts:
        state = "wrap requested" if e.get("wrap_requested") else "shut down" if e.get("shutdown") else "not active"
        die(f"{name} is already {state} (no tmux_session); nothing to do")
    if not has_session(ts):
        die(f"{name}: tmux session {ts} isn't running; run amx reconcile")
    return e, ts


def pane_worker(pane):
    worker = dict(session_id=pane["session_id"], harness=pane["kind"], cwd=pane["cwd"])
    worker.update({key: pane[key] for key in ("label", "model", "effort", "agent_args") if pane.get(key) is not None})
    return worker


def sync_workers(b, panes):
    """Refresh harness-scoped identity and launch settings, including existing workers."""
    if any(p.get("harness_conflict") for p in panes):
        die("pane harness metadata conflicts with its process; resolve it before saving identities")
    known = [(p["kind"], p["session_id"]) for p in panes if p["kind"] in AGENTS and p["session_id"]]
    if len(known) != len(set(known)):
        die("the same agent conversation is bound to several panes; resolve duplicate identities first")
    primary = next((p for p in panes if p["primary"]), None)
    if primary and primary["kind"] in AGENTS:
        set_primary_harness(b, primary["kind"])
        if primary["session_id"]:
            b.set("resumed_session_id", primary["session_id"])
        else:
            b.unset("resumed_session_id")
    running = {(p["kind"], p["session_id"]): p for p in panes
               if p["kind"] in AGENTS and p["session_id"] and not p["primary"]}
    previous = {worker_key(w): w for w in worker_records(b)}
    updated = [dict(previous_worker(previous, p), **pane_worker(p)) for p in running.values()]
    unresolved = unresolved_workers(previous, panes)
    for worker in previous.values():
        if worker_key(worker) not in running and worker_key(worker) not in unresolved:
            drop_worker(b, worker["session_id"], worker["harness"])
    for worker in updated:
        put_worker(b, worker)


def record_pane_ids(entry_id):
    reg = Registry.load()
    entry, session = live_entry(reg, entry_id)
    panes = inspect_panes(session, reg)
    mutate(lambda current: sync_workers(current.block(entry_id), panes))
    return {p["pane_id"]: p["session_id"] for p in panes if p["session_id"]}


def clear_pane_settings(pane):
    """Launch options belong to an adapter, not to the pane that once ran it."""
    for key, value in (("model", ""), ("effort", ""), ("agent_args", "[]")):
        tmux("set-option", "-p", "-t", pane, f"@amx_{key}", value)


def cmd_identify(a):
    if bool(a.pane) != bool(a.session_id):
        die("identify needs both --pane and --session-id for an explicit identity")
    if a.pane:
        reg = Registry.load()
        entry, session = live_entry(reg, a.id)
        panes = inspect_panes(session, reg)
        pane = next((p for p in panes if p["pane_id"] == a.pane), None)
        if not pane or pane["kind"] not in AGENTS:
            die(f"{a.pane} is not an agent pane in {a.id}")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", a.session_id):
            die("invalid session ID")
        if pane["kind"] in ("claude", "codex") and not UUID_RE.fullmatch(a.session_id):
            die(f"{pane['kind']} needs a full UUID")
        if any(p["pane_id"] != a.pane and (p["kind"], p["session_id"]) == (pane["kind"], a.session_id) for p in panes):
            die("this conversation ID is already bound to another pane")
        old = previous_worker({worker_key(w): w for w in worker_records(entry)},
                              dict(pane, kind=pane.get("managed_harness") or pane["kind"],
                                   session_id=pane.get("managed_id") or pane["session_id"])) if not pane["primary"] else {}
        prefix = codex_title_prefix(pane.get("title", "")) if pane["kind"] == "codex" else None
        if prefix and not a.session_id.startswith(prefix):
            die("session ID does not match this pane's native Codex title")
        if pane.get("harness_conflict") or (pane["primary"] and harness_of(entry) != pane["kind"]):
            clear_pane_settings(a.pane)
        tmux("set-option", "-p", "-t", a.pane, "@amx_harness", pane["kind"])
        tmux("set-option", "-p", "-t", a.pane, "@amx_session_id", a.session_id)
        if pane.get("label"):
            tmux("set-option", "-p", "-t", a.pane, "@amx_label", pane["label"])
        def bind_identity(current):
            block = current.block(a.id)
            if pane["primary"]:
                set_primary_harness(block, pane["kind"])
                block.set("resumed_session_id", a.session_id)
            elif old:
                worker = dict(old, harness=pane["kind"], session_id=a.session_id)
                if old["harness"] != pane["kind"]:
                    for key in ("model", "effort", "agent_args"):
                        worker.pop(key, None)
                drop_worker(block, old["session_id"], old["harness"])
                put_worker(block, worker)
        mutate(bind_identity)
    ids = record_pane_ids(a.id)
    for pane, sid in ids.items():
        print(f"{pane}\t{sid}")
    entry = Registry.load().block(a.id)
    unknown = [p["pane_id"] for p in inspect_panes(entry.get("tmux_session"))
               if p["kind"] in AGENTS and not p["session_id"]]
    if unknown:
        print(f"WARNING: session ID still unknown for {', '.join(unknown)}; inspect the agent", file=sys.stderr)
        sys.exit(3)


def agent_status(action, session):
    """park: keep the session's LED key for a resume; clear: release it. Non-fatal."""
    if shutil.which("agent-status"):
        run(["agent-status", action, session], check=False)


def is_shared(session, reg=None):
    """A session the user works in: tmux auto-named it, or a manager runs there."""
    if re.fullmatch(r"\d+", session or ""):
        return True
    reg = reg or Registry.load()
    return any((m.split() or [""])[0].split(":")[0] == session for m in reg.header.get_all("manager"))


def guarded_kill(entry_name, ts, reg=None):
    """Kill ts only if it is this entry's own session. Returns what happened."""
    if ts != entry_name:
        return f"left tmux session {ts} running: its name isn't the entry id {entry_name}"
    if is_shared(ts, reg):
        return f"left tmux session {ts} running: it's shared (auto-named, or a manager runs there)"
    kill_session(ts)
    return None


def append_log(rec):
    rec = {"ts": datetime.now().isoformat(timespec="seconds"), **rec}
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(json.dumps(rec) + "\n")


def entry_keys(block):
    keys = [(harness_of(block), block.get("resumed_session_id"))] if block.get("resumed_session_id") else []
    return keys + [worker_key(worker) for worker in worker_records(block)]


def entry_ids(block):
    return [sid for _, sid in entry_keys(block)]


def entry_harnesses(block):
    harnesses = {harness_of(block), *(w["harness"] for w in worker_records(block))}
    session = block.get("tmux_session")
    if session and has_session(session):
        harnesses.update(r["managed_harness"] for r in pane_rows(session) if r.get("managed_harness") in HARNESSES)
    elif block.get("resume_state"):
        try:
            saved = parse_resume_state(Path(block.get("resume_state")).expanduser().read_text())
            harnesses.update(p["harness"] for w in saved["windows"] for p in w["panes"] if p.get("harness") in HARNESSES)
        except OSError:
            pass
    return harnesses


def log_removed(block, how):
    append_log({"event": "removed", "how": how, "entry": block.name, "tracked": not block.get("auto"),
                "session_ids": entry_ids(block), "session_keys": entry_keys(block), "fields": block.as_dict()})


def cmd_pause(a):
    reg = Registry.load()
    e, ts = live_entry(reg, a.id)
    on = {"on": True, "off": False}.get(a.mode, not e.get("paused"))

    def fn(reg):
        b = reg.block(a.id)
        if on:
            b.unset("auto")  # pausing it means keeping it
            b.set("paused", datetime.now().strftime("%Y-%m-%d"))
            if a.reason:
                b.set("notes", (b.get("notes") + " " if b.get("notes") else "") + f"Paused: {a.reason}")
        else:
            b.unset("paused")
        b.set("last_touched", now_str())
    mutate(fn)
    if on:
        tmux("set-option", "-t", f"={ts}:", "@amx_paused", "1")
        install_switcher()
    else:
        tmux("set-option", "-u", "-t", f"={ts}:", "@amx_paused", check=False)
    print(f"{a.id} {'paused' if on else 'unpaused'}")


def guard_secondary(entry, whole_session=False):
    session = entry.get("tmux_session")
    if not session or whole_session:
        return
    own = my_pane_quiet()
    if not own:
        return  # a manager outside tmux can still operate on a named container
    rows = pane_rows(session)
    row = next((r for r in rows if r["pane_id"] == own), None)
    if row and not primary_pane(row, rows):
        die(f"{own} is a secondary pane in {entry.name}; this operation affects the whole session. "
            "Finish only this worker instead, or obtain user agreement and pass --whole-session.")


def cmd_shutdown(a):
    reg = Registry.load()
    e, ts = live_entry(reg, a.id)
    guard_secondary(e, a.whole_session)
    snap = STATE / "snapshots" / f"{a.id}.txt"
    snapshot_session(ts, snap, 500)
    rs, missing, panes = write_resume_state(ts, STATE / "resume" / f"{a.id}.md", reg)
    if missing and not a.force:
        die("no session id for: " + "; ".join(missing) + f". Find it with `amx transcripts`, add it to {rs} "
            "(session_id: and harness: lines), then rerun with --force. Nothing killed.")

    def fn(reg):
        b = reg.block(a.id)
        b.unset("auto")  # shutting it down for later means keeping it
        sync_workers(b, panes)
        b.set("snapshot", str(snap))
        b.set("resume_state", str(rs))
        b.set("shutdown", now_str())
        if a.resume_target:
            b.set("resume_target", a.resume_target)
        b.set("last_touched", now_str())
        b.unset("tmux_session")
        b.unset("paused")
    mutate(fn)
    agent_status("park", ts)
    print(f"{a.id} shut down; snapshot {snap}; resume_state {rs}", flush=True)
    note = guarded_kill(a.id, ts, reg)
    if note:
        print(note)


def cmd_wrap(a):
    """Final: snapshot, remove the entry (kept in the session log), release
    the LED key, kill tmux. The journal entry is the caller's job, before this."""
    reg = Registry.load()
    e = reg.block(a.id)
    ts = e.get("tmux_session")
    live = bool(ts) and has_session(ts)
    snap = None
    if live:
        guard_secondary(e, a.whole_session)
        snap = STATE / "snapshots" / f"{a.id}.txt"
        panes = snapshot_session(ts, snap, 500)

    def fn(reg):
        b = reg.block(a.id)
        if live:
            sync_workers(b, panes)
            b.set("snapshot", str(snap))
        if a.notes:
            notes = " ".join(a.notes.split())  # a field is one registry line
            b.set("notes", f"{b.get('notes')} {notes}" if b.get("notes") else notes)
        log_removed(b, "wrap")
        reg.remove(a.id)
    mutate(fn)
    if ts:
        agent_status("clear", ts)
    print(f"{a.id} wrapped" + (f"; snapshot {snap}" if snap else ""), flush=True)
    if live:
        note = guarded_kill(a.id, ts, reg)
        if note:
            print(note)


