def cmd_reg(a):
    op = a.op
    if op == "show":
        reg = Registry.load()
        if a.json:
            data = {"header": reg.header.as_dict(),
                    "entries": {e.name: dict(e.as_dict(), harness=harness_of(e)) for e in reg.entries()}}
            if a.id:
                data = data["header"] if a.id == "@header" else data["entries"].get(a.id) or die(f"no entry '{a.id}'")
            print(json.dumps(data, indent=2))
        elif a.id:
            print("\n".join(reg.block(a.id).lines).rstrip())
        else:
            print(reg.text().rstrip())
        return
    if op == "get":
        v = Registry.load().block(a.id).get(a.key)
        if v is None:
            sys.exit(1)
        print(v)
        return
    def fn(reg):
        if op == "new":
            b = reg.new(a.id)
            if not any(x.startswith("started=") for x in a.assign):
                a.assign.insert(0, "started=now")
            if not any(x.startswith("last_touched=") for x in a.assign):
                a.assign.append("last_touched=now")
            apply_assign(b, a.assign)
        elif op == "set":
            apply_assign(reg.block(a.id), a.assign)
        elif op == "unset":
            b = reg.block(a.id)
            for k in a.keys:
                if "=" in k:
                    key, match = k.split("=", 1)
                    removed = drop_worker(b, match) if key == "worker" and " " not in match else b.unset(key, match)
                    if not removed:
                        die(f"no '{key}' line matching '{match}' in {a.id}")
                else:
                    b.unset(k)
        elif op == "rm":
            log_removed(reg.block(a.id), "rm")
            reg.remove(a.id)
        elif op == "worker":
            b = reg.block(a.id)
            if a.action == "add":
                extra = {}
                for item in a.extra:
                    key, assign_op, value = parse_assignment(item)
                    if assign_op != "=" or key == "session_id":
                        die("worker fields use key=value; session ID is positional")
                    extra[key] = value
                if a.harness and extra.get("harness", a.harness) != a.harness:
                    die("conflicting worker harnesses")
                put_worker(b, dict(extra, session_id=a.session_id,
                                   harness=a.harness or extra.get("harness") or harness_of(b)))
            elif not drop_worker(b, a.session_id, a.harness):
                print(f"no worker line for {a.session_id} in {a.id}; nothing to drop", file=sys.stderr)
                return
            if a.id != "@header":
                b.set("last_touched", now_str())
    mutate(fn)


def apply_assign(block, assigns):
    for x in assigns:
        key, op, val = parse_assignment(x)
        if op == "+=":
            block.append(key, val)
        else:
            block.set(key, val)


