#!/usr/bin/env python3
"""Track Claude Code session status per tmux session.

Fed by Claude Code hooks (`agent-status event` with hook JSON on stdin),
read by renderers (keyboard LEDs, on-screen twin). State lives in
~/.local/state/agent-status/<tmux-session>.json:

    {"tmux_session", "state", "slot", "label", "ts",
     "claudes": {session_id: {"state", "pane_id"}}}

States: idle, working, done, needs_input, error, off. The top-level
state aggregates the per-Claude sub-states by priority
(needs_input > error > working > done > idle; off when none remain).
Slot assignment is single-mechanism and remembered: slots.json maps
session names to slots so a recreated session reclaims its key; a
live incumbent always wins; new sessions prefer never-remembered
slots. Assignment runs under a store lock. `slot <session> <n>`
pins manually.
"""

import contextlib
import json
import os
import re
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/state/agent-status")
MAX_SLOTS = 36  # 1-18 right half; 19-36 left-half spillover, used only when full

EVENT_STATES = {
    "SessionStart": "idle",
    "UserPromptSubmit": "working",
    # heartbeat: clears a stale needs_input once the permission is
    # answered and the turn resumes (no hook fires for that directly)
    "PostToolUse": "working",
    "Stop": "done",
    "Notification": "needs_input",
}

# "off": Claude exited cleanly but the tmux session lives on — LED dark,
# slot stays bound to the tmux session (keys switch to tmux sessions,
# so bindings shouldn't churn when a Claude restarts)
STATES = ("idle", "working", "done", "needs_input", "error", "off")


def state_path(tmux_session):
    return os.path.join(STATE_DIR, f"{tmux_session}.json")


def read_all():
    entries = {}
    if not os.path.isdir(STATE_DIR):
        return entries
    for name in os.listdir(STATE_DIR):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(STATE_DIR, name)) as f:
                e = json.load(f)
            entries[e["tmux_session"]] = e
        except (json.JSONDecodeError, KeyError, OSError):
            continue
    return entries


def write(entry):
    os.makedirs(STATE_DIR, exist_ok=True)
    entry["ts"] = int(time.time())
    tmp = state_path(entry["tmux_session"]) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entry, f)
    os.replace(tmp, state_path(entry["tmux_session"]))


def current_tmux_session():
    if "TMUX" not in os.environ:
        return None
    try:
        out = subprocess.run(
            ["tmux", "display-message", "-p", "#{session_name}"],
            capture_output=True, text=True, timeout=5,
        )
        return out.stdout.strip() or None
    except (subprocess.SubprocessError, OSError):
        return None


# Claude Code panes report the CLI's version string (e.g. "2.1.220")
# as pane_current_command; accept claude/node as fallbacks
_CLAUDE_CMD = re.compile(r"^(\d+\.\d+\.\d+|claude|node)$")


def claude_panes(tmux_session):
    """pane_id -> whether it looks like a Claude pane."""
    try:
        out = subprocess.run(
            ["tmux", "list-panes", "-s", "-t", f"={tmux_session}",
             "-F", "#{pane_id} #{pane_current_command}"],
            capture_output=True, text=True, timeout=5,
        )
    except (subprocess.SubprocessError, OSError):
        return {}
    panes = {}
    if out.returncode == 0:
        for line in out.stdout.splitlines():
            pane, _, cmd = line.partition(" ")
            panes[pane] = bool(_CLAUDE_CMD.match(cmd.strip()))
    return panes


# when several Claudes share a tmux session, the entry shows the
# highest-priority state among them
STATE_PRIORITY = ("needs_input", "error", "working", "done", "idle")


def aggregate(claudes):
    states = {c.get("state") for c in claudes.values()}
    for s in STATE_PRIORITY:
        if s in states:
            return s
    return "off"


def make_label(tmux_session, cwd):
    """The tmux session name is usually the descriptive one (manager
    sessions are named by registry id); fall back to the cwd basename
    for auto-numbered sessions."""
    if tmux_session and not tmux_session.isdigit():
        return tmux_session
    return os.path.basename(cwd or "") or tmux_session


SLOTS_FILE = os.path.join(STATE_DIR, "slots.json")
LOCK_DIR = os.path.join(STATE_DIR, ".lock")
SLOT_MEMORY_DAYS = 60


@contextlib.contextmanager
def store_lock(timeout=2.0):
    """Serialise read-assign-write across concurrent hook processes.
    Best-effort: proceeds unlocked after the timeout rather than ever
    stalling a hook; a lock dir older than 10s is treated as stale."""
    deadline = time.time() + timeout
    got = False
    while time.time() < deadline:
        try:
            os.makedirs(LOCK_DIR)
            got = True
            break
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(LOCK_DIR) > 10:
                    os.rmdir(LOCK_DIR)
                    continue
            except OSError:
                pass
            time.sleep(0.05)
    try:
        yield
    finally:
        if got:
            with contextlib.suppress(OSError):
                os.rmdir(LOCK_DIR)


def read_slot_memory():
    try:
        with open(SLOTS_FILE) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def remember_slot(name, slot):
    """Persist name -> slot so a recreated session reclaims its key."""
    if not slot:
        return
    mem = read_slot_memory()
    mem[name] = {"slot": slot, "ts": int(time.time())}
    cutoff = time.time() - SLOT_MEMORY_DAYS * 86400
    mem = {k: v for k, v in mem.items() if v.get("ts", 0) > cutoff}
    tmp = SLOTS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(mem, f)
    os.replace(tmp, SLOTS_FILE)


def forget_slot(name):
    mem = read_slot_memory()
    if mem.pop(name, None) is not None:
        tmp = SLOTS_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(mem, f)
        os.replace(tmp, SLOTS_FILE)


def assign_slot(tmux_session, entries):
    """A live incumbent always keeps its slot; a returning session
    reclaims its remembered one if free; new sessions prefer
    never-remembered slots, then the stalest memory."""
    live_taken = {e.get("slot") for e in entries.values()
                  if e.get("tmux_session") != tmux_session}
    mem = read_slot_memory()
    remembered = (mem.get(tmux_session) or {}).get("slot")
    if remembered and remembered not in live_taken:
        return remembered
    reserved = {v["slot"]: v.get("ts", 0)
                for k, v in mem.items() if k != tmux_session and "slot" in v}
    for n in range(1, MAX_SLOTS + 1):
        if n not in live_taken and n not in reserved:
            return n
    stale_free = [(ts, n) for n, ts in reserved.items()
                  if n not in live_taken]
    if stale_free:
        return min(stale_free)[1]
    return None  # more sessions than slots: tracked, unlit


def cmd_event():
    try:
        hook = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0  # never break the hook chain
    event = hook.get("hook_event_name", "")
    tmux_session = current_tmux_session()
    if tmux_session is None:
        return 0  # not in tmux: nothing to track against

    caller_id = hook.get("session_id") or "unknown"
    caller_pane = os.environ.get("TMUX_PANE")

    if event == "Notification":
        # Claude Code also sends idle "waiting for your input"
        # notifications; only real attention requests are needs_input
        if "waiting for your input" in (hook.get("message") or "").lower():
            return 0

    with store_lock():
        return apply_event(event, hook, tmux_session, caller_id,
                           caller_pane)


def apply_event(event, hook, tmux_session, caller_id, caller_pane):
    entries = read_all()
    entry = entries.get(tmux_session)

    if event == "SessionEnd":
        if not entry:
            return 0
        claudes = entry.get("claudes") or {}
        claudes.pop(caller_id, None)
        entry["claudes"] = claudes
        others = [p for p, is_claude in claude_panes(tmux_session).items()
                  if is_claude and p != caller_pane]
        if claudes:
            entry["state"] = aggregate(claudes)
        elif not others:
            entry["state"] = "off"  # slot stays bound to the tmux session
        write(entry)
        return 0

    state = EVENT_STATES.get(event)
    if state is None:
        return 0

    if entry is None:
        entry = {"tmux_session": tmux_session,
                 "slot": assign_slot(tmux_session, entries)}
    claudes = entry.get("claudes")
    if claudes is None:
        claudes = {}
        # migrate a single-owner entry from before per-Claude states
        if entry.get("session_id") and entry.get("state") not in (None, "off"):
            claudes[entry["session_id"]] = {"state": entry["state"],
                                            "pane_id": entry.get("pane_id")}
        entry.pop("session_id", None)
        entry.pop("pane_id", None)
    claudes[caller_id] = {"state": state, "pane_id": caller_pane}
    # drop Claudes whose pane no longer runs one (crashed/replaced)
    panes = claude_panes(tmux_session)
    for sid in list(claudes):
        if sid != caller_id:
            pane = claudes[sid].get("pane_id")
            if not (pane and panes.get(pane)):
                del claudes[sid]
    entry["claudes"] = claudes
    entry["label"] = make_label(tmux_session, hook.get("cwd"))
    entry["state"] = aggregate(claudes)
    remember_slot(tmux_session, entry.get("slot"))
    write(entry)
    return 0


def cmd_set(tmux_session, state):
    if state not in STATES:
        print(f"unknown state {state!r}, want one of {', '.join(STATES)}",
              file=sys.stderr)
        return 1
    entries = read_all()
    entry = entries.get(tmux_session) or {
        "tmux_session": tmux_session,
        "slot": assign_slot(tmux_session, entries),
        "label": tmux_session,
    }
    entry["state"] = state
    write(entry)
    return 0


# physical key per slot on the agent layer (19+ = left-half spillover)
SLOT_KEYS = ["Y", "U", "I", "O", "P", "\\", "H", "J", "K", "L", ";",
             "'", "N", "M", ",", ".", "/", "⇧",
             "⇥", "Q", "W", "E", "R", "T", "⌃", "A", "S", "D", "F",
             "G", "⇧", "Z", "X", "C", "V", "B"]


def cmd_list():
    entries = sorted(read_all().values(), key=lambda e: e.get("slot") or 99)
    for e in entries:
        slot = e.get("slot")
        key = SLOT_KEYS[slot - 1] if slot and slot <= len(SLOT_KEYS) else "-"
        print(f"{key:>2}  {e['state']:<11} "
              f"{e['tmux_session']}  ({e.get('label', '')})")
    return 0


def cmd_clear(tmux_session=None):
    with store_lock():
        if tmux_session:
            try:
                os.remove(state_path(tmux_session))
            except OSError:
                pass
            forget_slot(tmux_session)
        elif os.path.isdir(STATE_DIR):
            for name in os.listdir(STATE_DIR):
                if name.endswith(".json") or name == "slots.json":
                    os.remove(os.path.join(STATE_DIR, name))
    return 0


def cmd_slot(tmux_session, slot):
    """Manually place a session on a key (persisted)."""
    try:
        slot = int(slot)
        assert 1 <= slot <= MAX_SLOTS
    except (ValueError, AssertionError):
        print(f"slot must be 1-{MAX_SLOTS}", file=sys.stderr)
        return 1
    with store_lock():
        entries = read_all()
        for e in entries.values():
            if e.get("slot") == slot and e["tmux_session"] != tmux_session:
                print(f"slot {slot} is held by live session "
                      f"{e['tmux_session']!r} — clear it first",
                      file=sys.stderr)
                return 1
        remember_slot(tmux_session, slot)
        entry = entries.get(tmux_session)
        if entry:
            entry["slot"] = slot
            write(entry)
    print(f"{tmux_session} -> slot {slot}")
    return 0


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    cmd, rest = args[0], args[1:]
    if cmd == "event":
        return cmd_event()
    if cmd == "set" and len(rest) == 2:
        return cmd_set(*rest)
    if cmd == "list":
        return cmd_list()
    if cmd == "clear":
        return cmd_clear(rest[0] if rest else None)
    if cmd == "slot" and len(rest) == 2:
        return cmd_slot(*rest)
    print("usage: agent-status event|set <session> <state>|list"
          "|clear [session]|slot <session> <n>",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
