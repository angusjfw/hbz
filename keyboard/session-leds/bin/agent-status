#!/usr/bin/env python3
"""Track Claude Code session status per tmux session.

Fed by Claude Code hooks (`agent-status event` with hook JSON on stdin),
read by renderers (keyboard LEDs, on-screen twin). State lives in
~/.local/state/agent-status/<tmux-session>.json:

    {"tmux_session", "state", "slot", "label", "session_id", "ts"}

States: idle, working, done, needs_input, error.
Slots come from the claude-manager registry when present, otherwise
the lowest free slot is auto-assigned on first event.
"""

import json
import os
import re
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/state/agent-status")
REGISTRY = os.path.expanduser("~/.local/state/claude-manager/sessions.md")
MAX_SLOTS = 18

EVENT_STATES = {
    "SessionStart": "idle",
    "UserPromptSubmit": "working",
    # heartbeat: clears a stale needs_input once the permission is
    # answered and the turn resumes (no hook fires for that directly)
    "PostToolUse": "working",
    "Stop": "done",
    "Notification": "needs_input",
}

# "off": Claude exited cleanly but the tmux session lives on — LED dark,
# slot stays bound to the tmux session (keys switch to tmux sessions,
# so bindings shouldn't churn when a Claude restarts)
STATES = ("idle", "working", "done", "needs_input", "error", "off")


def state_path(tmux_session):
    return os.path.join(STATE_DIR, f"{tmux_session}.json")


def read_all():
    entries = {}
    if not os.path.isdir(STATE_DIR):
        return entries
    for name in os.listdir(STATE_DIR):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(STATE_DIR, name)) as f:
                e = json.load(f)
            entries[e["tmux_session"]] = e
        except (json.JSONDecodeError, KeyError, OSError):
            continue
    return entries


def write(entry):
    os.makedirs(STATE_DIR, exist_ok=True)
    entry["ts"] = int(time.time())
    tmp = state_path(entry["tmux_session"]) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(entry, f)
    os.replace(tmp, state_path(entry["tmux_session"]))


def current_tmux_session():
    if "TMUX" not in os.environ:
        return None
    try:
        out = subprocess.run(
            ["tmux", "display-message", "-p", "#{session_name}"],
            capture_output=True, text=True, timeout=5,
        )
        return out.stdout.strip() or None
    except (subprocess.SubprocessError, OSError):
        return None


# Claude Code panes report the CLI's version string (e.g. "2.1.220")
# as pane_current_command; accept claude/node as fallbacks
_CLAUDE_CMD = re.compile(r"^(\d+\.\d+\.\d+|claude|node)$")


def claude_panes(tmux_session):
    """pane_id -> whether it looks like a Claude pane."""
    try:
        out = subprocess.run(
            ["tmux", "list-panes", "-s", "-t", f"={tmux_session}",
             "-F", "#{pane_id} #{pane_current_command}"],
            capture_output=True, text=True, timeout=5,
        )
    except (subprocess.SubprocessError, OSError):
        return {}
    panes = {}
    if out.returncode == 0:
        for line in out.stdout.splitlines():
            pane, _, cmd = line.partition(" ")
            panes[pane] = bool(_CLAUDE_CMD.match(cmd.strip()))
    return panes


# when several Claudes share a tmux session, the entry shows the
# highest-priority state among them
STATE_PRIORITY = ("needs_input", "error", "working", "done", "idle")


def aggregate(claudes):
    states = {c.get("state") for c in claudes.values()}
    for s in STATE_PRIORITY:
        if s in states:
            return s
    return "off"


def make_label(tmux_session, cwd):
    """The tmux session name is usually the descriptive one (manager
    sessions are named by registry id); fall back to the cwd basename
    for auto-numbered sessions."""
    if tmux_session and not tmux_session.isdigit():
        return tmux_session
    return os.path.basename(cwd or "") or tmux_session


def registry_slot(tmux_session):
    """slot field from the claude-manager registry entry, if any."""
    try:
        with open(REGISTRY) as f:
            text = f.read()
    except OSError:
        return None
    for section in re.split(r"^## ", text, flags=re.M)[1:]:
        fields = dict(re.findall(r"^(\w+):\s*(.+)$", section, flags=re.M))
        if fields.get("tmux_session") == tmux_session and "slot" in fields:
            try:
                return int(fields["slot"])
            except ValueError:
                return None
    return None


def registry_slots():
    """Every slot number reserved in the claude-manager registry."""
    try:
        with open(REGISTRY) as f:
            return {int(m) for m in
                    re.findall(r"^slot:\s*(\d+)$", f.read(), flags=re.M)}
    except OSError:
        return set()


def assign_slot(tmux_session, entries):
    slot = registry_slot(tmux_session)
    if slot is not None:
        return slot
    taken = {e.get("slot") for e in entries.values()} | registry_slots()
    for n in range(1, MAX_SLOTS + 1):
        if n not in taken:
            return n
    return None  # more sessions than slots: tracked, unlit


def cmd_event():
    try:
        hook = json.load(sys.stdin)
    except json.JSONDecodeError:
        return 0  # never break the hook chain
    event = hook.get("hook_event_name", "")
    tmux_session = current_tmux_session()
    if tmux_session is None:
        return 0  # not in tmux: nothing to track against

    entries = read_all()
    entry = entries.get(tmux_session)
    caller_id = hook.get("session_id") or "unknown"
    caller_pane = os.environ.get("TMUX_PANE")

    if event == "Notification":
        # Claude Code also sends idle "waiting for your input"
        # notifications; only real attention requests are needs_input
        if "waiting for your input" in (hook.get("message") or "").lower():
            return 0

    if event == "SessionEnd":
        if not entry:
            return 0
        claudes = entry.get("claudes") or {}
        claudes.pop(caller_id, None)
        entry["claudes"] = claudes
        others = [p for p, is_claude in claude_panes(tmux_session).items()
                  if is_claude and p != caller_pane]
        if claudes:
            entry["state"] = aggregate(claudes)
        elif not others:
            entry["state"] = "off"  # slot stays bound to the tmux session
        write(entry)
        return 0

    state = EVENT_STATES.get(event)
    if state is None:
        return 0

    if entry is None:
        entry = {"tmux_session": tmux_session,
                 "slot": assign_slot(tmux_session, entries)}
    claudes = entry.get("claudes")
    if claudes is None:
        claudes = {}
        # migrate a single-owner entry from before per-Claude states
        if entry.get("session_id") and entry.get("state") not in (None, "off"):
            claudes[entry["session_id"]] = {"state": entry["state"],
                                            "pane_id": entry.get("pane_id")}
        entry.pop("session_id", None)
        entry.pop("pane_id", None)
    claudes[caller_id] = {"state": state, "pane_id": caller_pane}
    # drop Claudes whose pane no longer runs one (crashed/replaced)
    panes = claude_panes(tmux_session)
    for sid in list(claudes):
        if sid != caller_id:
            pane = claudes[sid].get("pane_id")
            if not (pane and panes.get(pane)):
                del claudes[sid]
    entry["claudes"] = claudes
    entry["label"] = make_label(tmux_session, hook.get("cwd"))
    # the registry is authoritative once the manager assigns a slot,
    # which may land after the session's first events
    reg = registry_slot(tmux_session)
    if reg is not None:
        entry["slot"] = reg
        entries[tmux_session] = entry
        # evict any squatter without its own registry claim
        for other in entries.values():
            if other is not entry and other.get("slot") == reg \
                    and registry_slot(other["tmux_session"]) != reg:
                other["slot"] = assign_slot(other["tmux_session"], entries)
                write(other)
    entry["state"] = aggregate(claudes)
    write(entry)
    return 0


def cmd_set(tmux_session, state):
    if state not in STATES:
        print(f"unknown state {state!r}, want one of {', '.join(STATES)}",
              file=sys.stderr)
        return 1
    entries = read_all()
    entry = entries.get(tmux_session) or {
        "tmux_session": tmux_session,
        "slot": assign_slot(tmux_session, entries),
        "label": tmux_session,
    }
    entry["state"] = state
    write(entry)
    return 0


# physical key per slot on the agent layer
SLOT_KEYS = ["Y", "U", "I", "O", "P", "\\", "H", "J", "K", "L", ";",
             "'", "N", "M", ",", ".", "/", "⇧"]


def cmd_list():
    entries = sorted(read_all().values(), key=lambda e: e.get("slot") or 99)
    for e in entries:
        slot = e.get("slot")
        key = SLOT_KEYS[slot - 1] if slot and slot <= len(SLOT_KEYS) else "-"
        print(f"{key:>2}  {e['state']:<11} "
              f"{e['tmux_session']}  ({e.get('label', '')})")
    return 0


def cmd_clear(tmux_session=None):
    if tmux_session:
        try:
            os.remove(state_path(tmux_session))
        except OSError:
            pass
    elif os.path.isdir(STATE_DIR):
        for name in os.listdir(STATE_DIR):
            if name.endswith(".json"):
                os.remove(os.path.join(STATE_DIR, name))
    return 0


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    cmd, rest = args[0], args[1:]
    if cmd == "event":
        return cmd_event()
    if cmd == "set" and len(rest) == 2:
        return cmd_set(*rest)
    if cmd == "list":
        return cmd_list()
    if cmd == "clear":
        return cmd_clear(rest[0] if rest else None)
    print(f"usage: agent-status event|set <session> <state>|list|clear [session]",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
