#!/usr/bin/env python3
"""Paint Claude session status onto the ZSA Voyager's agent layer.

Polls Keymapp (via kontroll) for the active layer. While the agent
layer is toggled on, takes host RGB control and paints one key per
session slot from the agent-status state dir; restores firmware
colours the moment the layer is left. Handles keyboard disconnects.

Requires Keymapp running with its API enabled, and kontroll on PATH.
"""

import json
import os
import signal
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/state/agent-status")
AGENT_LAYER = 3
BASE_LED = 26          # right half, top row: slot 1 = LED 26 (Y position)
MAX_SLOTS = 18         # three right-hand rows, LEDs 26-43
POLL_S = 0.1
FOCUS_CHECK_S = 1.0

COLORS = {
    "idle": "#FFFFFF",
    "working": "#0066FF",
    "done": "#00CC33",
    "needs_input": "#FFCC00",
    "error": "#FF0000",
}
OFF = "#000000"

if sys.platform == "darwin":
    DEFAULT_SOCK = os.path.expanduser(
        "~/Library/Application Support/.keymapp/keymapp.sock")
else:
    DEFAULT_SOCK = os.path.expanduser("~/.config/.keymapp/keymapp.sock")
SOCK = os.environ.get("KEYMAPP_SOCK", DEFAULT_SOCK)


def kontroll(*args):
    try:
        out = subprocess.run(
            ["kontroll", "-p", SOCK, *args],
            capture_output=True, text=True, timeout=5,
        )
        return out.stdout
    except (subprocess.SubprocessError, OSError):
        return ""


def current_layer():
    """Active layer number, or None when no keyboard is connected."""
    out = kontroll("status")
    for line in out.splitlines():
        if line.startswith("Current layer"):
            try:
                return int(line.split(":")[1])
            except ValueError:
                return None
    return None


def read_states():
    """slot -> state, plus the set of tmux sessions marked done."""
    slots, done_sessions = {}, {}
    if not os.path.isdir(STATE_DIR):
        return slots, done_sessions
    for name in os.listdir(STATE_DIR):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(STATE_DIR, name)) as f:
                e = json.load(f)
        except (json.JSONDecodeError, OSError):
            continue
        slot, state = e.get("slot"), e.get("state")
        session = e.get("tmux_session")
        if state == "done" and session:
            done_sessions[session] = e
        if slot and 1 <= slot <= MAX_SLOTS and state in COLORS:
            # dead tmux session without clean SessionEnd -> error
            if session and not tmux_session_alive(session):
                state = "error"
            slots[slot] = state
    return slots, done_sessions


_alive_cache = {}


def tmux_session_alive(session):
    now = time.time()
    cached = _alive_cache.get(session)
    if cached and now - cached[1] < 5:
        return cached[0]
    alive = subprocess.run(
        ["tmux", "has-session", "-t", f"={session}"],
        capture_output=True,
    ).returncode == 0
    _alive_cache[session] = (alive, now)
    return alive


def demote_done_on_focus(done_sessions):
    """done -> idle once the user is looking at the session."""
    if not done_sessions:
        return
    out = subprocess.run(
        ["tmux", "list-clients", "-F", "#{client_session}"],
        capture_output=True, text=True,
    ).stdout
    for session in set(out.split()) & set(done_sessions):
        e = done_sessions[session]
        e["state"] = "idle"
        e["ts"] = int(time.time())
        path = os.path.join(STATE_DIR, f"{session}.json")
        tmp = path + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(e, f)
            os.replace(tmp, path)
        except OSError:
            pass


def paint(slots, previous=None):
    """Paint changed slot LEDs concurrently.

    On first paint (previous None) only lit slots are sent — taking
    host control blanks every other LED anyway. Afterwards, diff
    against the previous frame, sending black for cleared slots.
    """
    procs = []
    for slot in range(1, MAX_SLOTS + 1):
        color = COLORS.get(slots.get(slot), OFF)
        if previous is None:
            if color == OFF:
                continue
        elif color == COLORS.get(previous.get(slot), OFF):
            continue
        procs.append(subprocess.Popen(
            ["kontroll", "-p", SOCK, "set-rgb",
             "-l", str(BASE_LED + slot - 1), "-c", color],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ))
    for p in procs:
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill()


def restore():
    kontroll("restore-rgb-leds")


def main():
    painting = False
    last_painted = None
    last_connect_try = 0.0
    last_focus_check = 0.0

    def bail(signum, frame):
        if painting:
            restore()
        sys.exit(0)

    signal.signal(signal.SIGINT, bail)
    signal.signal(signal.SIGTERM, bail)

    while True:
        layer = current_layer()

        if layer is None:
            if painting:
                painting, last_painted = False, None
            if time.time() - last_connect_try > 5:
                last_connect_try = time.time()
                kontroll("connect-any")
            time.sleep(1)
            continue

        slots, done_sessions = read_states()
        if time.time() - last_focus_check > FOCUS_CHECK_S:
            last_focus_check = time.time()
            demote_done_on_focus(done_sessions)

        if layer == AGENT_LAYER:
            if not painting or slots != last_painted:
                paint(slots, last_painted if painting else None)
                painting, last_painted = True, slots
        elif painting:
            restore()
            painting, last_painted = False, None

        time.sleep(POLL_S)


if __name__ == "__main__":
    main()
