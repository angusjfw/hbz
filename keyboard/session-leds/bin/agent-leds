#!/usr/bin/env python3
"""Paint Claude session status onto the ZSA Voyager.

Polls Keymapp (via kontroll) for the active layer and paints one key
per session slot from the agent-status state dir. Statuses show on
the base layer by default (home markers repainted alongside) and on
the agent layer (toggle key lit white); other layers keep their
firmware colours. Handles keyboard disconnects.

Requires Keymapp running with its API enabled, and kontroll on PATH.

Control (writes markers the running daemon honours):
    agent-leds pause          # stop all output AND Keymapp API traffic
                              # (use while flashing firmware)
    agent-leds pause notify   # only stop transition flashes
    agent-leds resume
    agent-leds base on|off    # always-on base-layer display (default on)
    agent-leds status
"""

import json
import os
import re
import signal
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/state/agent-status")
AGENT_LAYER = 3
BASE_LAYER = 0
BASE_LED = 26          # right half, top row: slot 1 = LED 26 (Y position)
MAX_SLOTS = 18         # three right-hand rows, LEDs 26-43
TOGGLE_LED = 49        # bottom-right TG(3) key: lit white on the agent layer
TOGGLE_COLOR = "#FFFFFF"
# the base ledmap's green home markers (F, J, thumbs), repainted so the
# always-on display doesn't lose them
HOME_MARKERS = {led: "#466914" for led in (10, 24, 33, 51)}
POLL_S = 0.1
FOCUS_CHECK_S = 1.0

COLORS = {
    "idle": "#FFFFFF",
    "working": "#0066FF",
    "done": "#00CC33",
    "needs_input": "#FFCC00",
    "error": "#FF0000",
}
OFF = "#000000"

# states worth a main-layer LED flash + desktop toast when entered
NOTIFY_STATES = {"done", "needs_input", "error"}
FLASH_S = 1.2

PAUSE_FILE = os.path.join(STATE_DIR, "leds-paused")
BASE_OFF_FILE = os.path.join(STATE_DIR, "leds-base-off")


def pause_mode():
    """None (running), 'notify' (no transition flashes), or 'all'."""
    try:
        with open(PAUSE_FILE) as f:
            mode = f.read().strip() or "all"
            return "notify" if mode == "flash" else mode
    except OSError:
        return None


def base_display_on():
    return not os.path.exists(BASE_OFF_FILE)

if sys.platform == "darwin":
    DEFAULT_SOCK = os.path.expanduser(
        "~/Library/Application Support/.keymapp/keymapp.sock")
else:
    DEFAULT_SOCK = os.path.expanduser("~/.config/.keymapp/keymapp.sock")
SOCK = os.environ.get("KEYMAPP_SOCK", DEFAULT_SOCK)


def kontroll(*args):
    try:
        out = subprocess.run(
            ["kontroll", "-p", SOCK, *args],
            capture_output=True, text=True, timeout=5,
        )
        return out.stdout
    except (subprocess.SubprocessError, OSError):
        return ""


def current_layer():
    """Active layer number, or None when no keyboard is connected."""
    out = kontroll("status")
    for line in out.splitlines():
        if line.startswith("Current layer"):
            try:
                return int(line.split(":")[1])
            except ValueError:
                return None
    return None


def read_states():
    """slot -> state, slot -> label, plus tmux sessions marked done."""
    slots, labels, done_sessions = {}, {}, {}
    if not os.path.isdir(STATE_DIR):
        return slots, labels, done_sessions
    for name in os.listdir(STATE_DIR):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(STATE_DIR, name)) as f:
                e = json.load(f)
        except (json.JSONDecodeError, OSError):
            continue
        slot, state = e.get("slot"), e.get("state")
        session = e.get("tmux_session")
        health = session_health(session) if session else "ok"
        if health == "gone":
            # tmux session no longer exists: not a crash, just cleanup
            try:
                os.remove(os.path.join(STATE_DIR, name))
            except OSError:
                pass
            continue
        if state == "done" and session:
            done_sessions[session] = e
        if slot and 1 <= slot <= MAX_SLOTS and state in COLORS:
            # tmux alive but no Claude process left -> it died uncleanly
            if health == "no_claude":
                state = "error"
            slots[slot] = state
            labels[slot] = e.get("label") or session or f"slot {slot}"
    return slots, labels, done_sessions


_health_cache = {}

# Claude Code panes report the CLI's version string (e.g. "2.1.220")
# as pane_current_command; accept claude/node as fallbacks
_CLAUDE_CMD = re.compile(r"^(\d+\.\d+\.\d+|claude|node)$")


def session_health(session):
    """'gone' (no tmux session), 'ok' (has a Claude pane), or
    'no_claude' (session alive, Claude process vanished)."""
    now = time.time()
    cached = _health_cache.get(session)
    if cached and now - cached[1] < 5:
        return cached[0]
    out = subprocess.run(
        ["tmux", "list-panes", "-s", "-t", f"={session}",
         "-F", "#{pane_current_command}"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        health = "gone"
    elif any(_CLAUDE_CMD.match(c) for c in out.stdout.split()):
        health = "ok"
    else:
        health = "no_claude"
    _health_cache[session] = (health, now)
    return health


def demote_done_on_focus(done_sessions):
    """done -> idle once the user is looking at the session."""
    if not done_sessions:
        return
    out = subprocess.run(
        ["tmux", "list-clients", "-F", "#{client_session}"],
        capture_output=True, text=True,
    ).stdout
    for session in set(out.split()) & set(done_sessions):
        e = done_sessions[session]
        e["state"] = "idle"
        e["ts"] = int(time.time())
        path = os.path.join(STATE_DIR, f"{session}.json")
        tmp = path + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(e, f)
            os.replace(tmp, path)
        except OSError:
            pass


def slot_leds(slots):
    """slot -> state dict as a led -> colour frame."""
    return {BASE_LED + slot - 1: COLORS[state]
            for slot, state in slots.items()}


def paint(frame, previous=None):
    """Paint changed LEDs concurrently. frame is {led: colour}.

    On first paint (previous None) only lit LEDs are sent — taking
    host control blanks every other LED anyway. Afterwards, diff
    against the previous frame, sending black for cleared LEDs.
    """
    procs = []
    for led in set(frame) | set(previous or ()):
        color = frame.get(led, OFF)
        if previous is None:
            if color == OFF:
                continue
        elif previous.get(led, OFF) == color:
            continue
        procs.append(subprocess.Popen(
            ["kontroll", "-p", SOCK, "set-rgb",
             "-l", str(led), "-c", color],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ))
    for p in procs:
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill()


def restore():
    kontroll("restore-rgb-leds")


def notify_hs(event, **params):
    """Fire-and-forget a hammerspoon:// URL event (macOS only)."""
    if sys.platform != "darwin":
        return
    import urllib.parse
    url = f"hammerspoon://{event}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    subprocess.Popen(["open", "-g", url],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def flash(changes):
    """Briefly paint changed slots on the otherwise-dark board, then
    hand colours back. One takeover per state change; input mapping is
    unaffected throughout."""
    for slot, state in changes.items():
        kontroll("set-rgb", "-l", str(BASE_LED + slot - 1),
                 "-c", COLORS[state])
    time.sleep(FLASH_S)
    restore()


def main():
    painting = False
    last_painted = None
    last_connect_try = 0.0
    last_focus_check = 0.0
    prev_slots = None  # None = first read, never flash on startup
    hud_shown = False

    def bail(signum, frame):
        if painting:
            restore()
        notify_hs("agent-hud", show="0")
        sys.exit(0)

    signal.signal(signal.SIGINT, bail)
    signal.signal(signal.SIGTERM, bail)

    while True:
        paused = pause_mode()

        # full pause = zero Keymapp API traffic, so flashing firmware
        # isn't disturbed; one restore call to hand colours back first
        if paused == "all":
            layer = None
            if painting:
                restore()
                painting, last_painted = False, None
        else:
            layer = current_layer()

        # keyboard gone: keep host-side features running, try to get
        # the connection back in the background
        if layer is None and paused != "all":
            if painting:
                painting, last_painted = False, None
            if time.time() - last_connect_try > 5:
                last_connect_try = time.time()
                if sys.platform == "darwin" and not os.path.exists(SOCK):
                    subprocess.Popen(["open", "-ga", "Keymapp"],
                                     stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
                else:
                    kontroll("connect-any")

        slots, labels, done_sessions = read_states()
        if time.time() - last_focus_check > FOCUS_CHECK_S:
            last_focus_check = time.time()
            demote_done_on_focus(done_sessions)

        changes = {}
        if prev_slots is not None:
            changes = {s: st for s, st in slots.items()
                       if st in NOTIFY_STATES and prev_slots.get(s) != st}
        prev_slots = slots

        # what this layer should show
        frame = {}
        if paused != "all":
            if layer == AGENT_LAYER:
                frame = slot_leds(slots) | {TOGGLE_LED: TOGGLE_COLOR}
            elif layer == BASE_LAYER and base_display_on():
                # markers first: an occupied slot outranks its marker
                frame = dict(HOME_MARKERS) | slot_leds(slots)

        # HUD only while the agent layer is toggled
        want_hud = paused != "all" and layer == AGENT_LAYER
        if want_hud != hud_shown:
            notify_hs("agent-hud", show="1" if want_hud else "0")
            hud_shown = want_hud

        if frame:
            if not painting or frame != last_painted:
                paint(frame, last_painted if painting else None)
                painting, last_painted = True, frame
        elif painting:
            if layer is not None and paused != "all":
                restore()
            painting, last_painted = False, None

        if paused != "all" and layer not in (AGENT_LAYER, None):
            for slot, state in changes.items():
                notify_hs("agent-toast",
                          label=labels.get(slot, f"slot {slot}"),
                          state=state)
            # a continuous display already shows the change; flash
            # only when this layer displays nothing
            if changes and not frame and paused != "notify":
                flash(changes)

        time.sleep(POLL_S if layer is not None else 1)


def ctl(args):
    cmd = args[0]
    if cmd == "pause":
        mode = args[1] if len(args) > 1 else "all"
        if mode == "flash":  # old name for the notify mode
            mode = "notify"
        if mode not in ("all", "notify"):
            print(f"unknown pause mode {mode!r}, want notify or nothing",
                  file=sys.stderr)
            return 1
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(PAUSE_FILE, "w") as f:
            f.write(mode)
        print(f"paused ({mode})")
    elif cmd == "resume":
        try:
            os.remove(PAUSE_FILE)
        except OSError:
            pass
        print("running")
    elif cmd == "base" and len(args) > 1 and args[1] in ("on", "off"):
        if args[1] == "off":
            os.makedirs(STATE_DIR, exist_ok=True)
            open(BASE_OFF_FILE, "w").close()
        else:
            try:
                os.remove(BASE_OFF_FILE)
            except OSError:
                pass
        print(f"base-layer display {args[1]}")
    elif cmd == "status":
        mode = pause_mode()
        print(f"paused ({mode})" if mode else "running",
              "| base-layer display",
              "on" if base_display_on() else "off")
    else:
        print("usage: agent-leds [pause [notify]|resume|base on|off|status]",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1:
        sys.exit(ctl(sys.argv[1:]))
    main()
