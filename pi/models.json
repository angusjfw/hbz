{
  // Notes on models live here as comments (models.json supports JSONC).
  // Prices are USD per million tokens. Coding is the primary use; one or
  // two reasoning models are kept for occasional hard problems.
  "providers": {
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434/v1",
      "api": "openai-completions",
      "apiKey": "ollama",
      "models": [
        {
          // Default: coding-specialized agent model. Vision in, cheap.
          "id": "kimi-k2.7-code:cloud",
          "name": "Kimi K2.7 Code (Ollama Cloud)",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 262144,
          "maxTokens": 32768,
          "cost": {
            "input": 0.95,
            "output": 4.0,
            "cacheRead": 0.19,
            "cacheWrite": 0
          }
        },
        {
          // Coding + agentic, vision in. Best capability-per-dollar of the set.
          "id": "minimax-m3:cloud",
          "name": "MiniMax M3 (Ollama Cloud)",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 32768,
          "cost": {
            "input": 0.6,
            "output": 2.4,
            "cacheRead": 0.12,
            "cacheWrite": 0
          }
        },
        {
          // Fast/cheap coding fill-in for routine edits and lookups.
          "id": "deepseek-v4.1-flash:cloud",
          "name": "DeepSeek V4.1 Flash (Ollama Cloud)",
          "input": [
            "text",
            "image"
          ],
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 32768,
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cacheRead": 0.006,
            "cacheWrite": 0
          }
        },
        {
          // Reasoning holdover: frontier MoE generalist for hard problems.
          "id": "deepseek-v4-pro:cloud",
          "name": "DeepSeek V4 Pro (Ollama Cloud)",
          "input": [
            "text"
          ],
          "reasoning": true,
          "contextWindow": 1000000,
          "maxTokens": 32768,
          "cost": {
            "input": 1.32,
            "output": 3.96,
            "cacheRead": 0.044,
            "cacheWrite": 0
          }
        },
        {
          // Local offline model (GGUF), free after download.
          "id": "ornith-agent",
          "name": "Ornith 9B (local)",
          "input": [
            "text"
          ],
          "reasoning": true,
          "contextWindow": 32768,
          "maxTokens": 8192,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "thinkingLevelMap": {
            "off": "none"
          },
          "compat": {
            "supportsReasoningEffort": true
          }
        },
        {
          // Local offline model (GGUF), free after download.
          "id": "gpt-oss-agent",
          "name": "gpt-oss 20B (local)",
          "input": [
            "text"
          ],
          "reasoning": true,
          "contextWindow": 32768,
          "maxTokens": 8192,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      ]
    }
  }
}
