{
  "defaultProvider": "ollama",
  "defaultModel": "deepseek-v4-pro:cloud",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "ollama/deepseek-v4-pro:cloud",
    "ollama/kimi-k2.7-code:cloud",
    "openrouter/moonshotai/kimi-k2.7-code",
    "ollama/kimi-k3:cloud",
    "ollama/glm-5.3:cloud",
    "ollama/minimax-m3:cloud",
    "ollama/deepseek-v4.1-flash:cloud",
    "ollama/glm-5.3-flash:cloud",
    "ollama/gpt-oss:120b-cloud",
    "openrouter/openai/gpt-6-sol",
    "openrouter/openai/gpt-6-luna",
    "openrouter/openai/gpt-5.6-sol",
    "openrouter/openai/gpt-5.6-terra",
    "openrouter/openai/gpt-5.6-luna",
    "ollama/ornith-agent",
    "ollama/gpt-oss-agent"
  ],
  "theme": "light",
  "skills": [
    "~/.claude/skills/tmux-interaction",
    "~/.claude/skills/claude-manager",
    "~/.claude/skills/claude-manager-worker",
    "~/.claude/skills/review-pr",
    "~/.claude/skills/run",
    "~/.claude/skills/prune-worktrees",
    "-skills/agents-sdk",
    "-skills/cloudflare",
    "-skills/cloudflare-email-service",
    "-skills/cloudflare-one",
    "-skills/cloudflare-one-migrations",
    "-skills/durable-objects",
    "-skills/sandbox-sdk",
    "-skills/turnstile-spin",
    "-skills/web-perf",
    "-skills/workers-best-practices",
    "-skills/wrangler"
  ],
  "packages": [
    {
      "source": "git:github.com/mitsuhiko/agent-stuff@122e299",
      "extensions": [
        "extensions/answer.ts",
        "extensions/btw.ts",
        "extensions/continue.ts",
        "extensions/control.ts",
        "extensions/review.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:@czottmann/pi-automode@1.17.0",
    "npm:pi-vim@0.14.2"
  ]
}
