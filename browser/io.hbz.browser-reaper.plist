<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.hbz.browser-reaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/reap-agent-browsers</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/browser-reaper.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/browser-reaper.log</string>
</dict>
</plist>
