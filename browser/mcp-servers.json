{
  "chrome-devtools": {
    "command": "__HOME__/.local/bin/chrome-devtools-mcp",
    "args": ["--autoConnect"]
  },
  "playwright": {
    "port": 8768,
    "command": "npx",
    "args": [
      "-y", "@playwright/mcp@0.0.83",
      "--headless", "--isolated", "--browser", "chromium",
      "--idle-timeout", "600000",
      "--output-dir", "__HOME__/.cache/playwright-mcp",
      "--host", "127.0.0.1", "--port", "8768",
      "--allowed-hosts", "127.0.0.1:8768,localhost:8768"
    ]
  }
}
